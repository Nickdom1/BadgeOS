#include "sg2000-milkv-duo-s-riscv.dts"

/* Opt-in manual display graph. Ordinary public board configurations omit it.
 * IIC2 uses SG2000 BGA J13/J14, function 0, fixed 1.8 V and 10k pull-ups.
 * See drivers/pinctrl/sophgo/pinctrl-sg2000.c; no bias/drive override.
 */
#define DUOS_IIC2_SCL PINPOS('J', 13)
#define DUOS_IIC2_SDA PINPOS('J', 14)
/ { aliases { i2c2 = &i2c2; }; };
&pinctrl {
	iic2_cfg: iic2-cfg {
		iic2-scl-pins {
			pinmux = <PINMUX(DUOS_IIC2_SCL, 0)>;
			power-source = <1800>;
		};
		iic2-sda-pins {
			pinmux = <PINMUX(DUOS_IIC2_SDA, 0)>;
			power-source = <1800>;
		};
	};
};

/* osdrv aa542c41 interdrv/vpss/chip/cv181x/vpss_core.c:_init_resources,
 * interdrv/base/base.c:base_probe and scaler_reg.h define these windows.
 * Keep register-interface clock 128 on both the syscon and DSI host.
 */
/ {
	soc {
		vip_sys: syscon@a0c8000 {
			compatible = "sophgo,sg2000-vip-sys", "syscon";
			reg = <0x0a0c8000 0x1000>;
			/* Linux 7.2.2 clk-cv1800.c:clk_cfg_reg_vip gates the
			 * register interface separately from the AXI VIP children.
			 * mfd/syscon.c attaches this clock to regmap-mmio, which
			 * enables it around every access. A VIP read stalls without this
			 * dependency; no reset is implied.
			 */
			clocks = <&clk CLK_CFG_REG_VIP>;
			status = "okay";
		};

		sophgo_dsi: dsi@a080000 {
			compatible = "sophgo,sg2000-dsi";
			reg = <0x0a080000 0x1000>,
			      <0x0a088000 0x1000>,
			      <0x0a08a000 0x1000>,
			      <0x0a0d1000 0x1000>;
			reg-names = "sc_top", "disp", "dsi_mac", "dphy";
			sophgo,vip-sys = <&vip_sys>;
			clocks = <&clk CLK_SC_TOP_VIP>,
				 <&clk CLK_DISP_VIP>, <&clk CLK_DSI_MAC_VIP>,
				 <&clk CLK_DSI_ESC>, <&clk CLK_DISPPLL>,
				 <&clk CLK_DISP_SRC_VIP>, <&clk CLK_DSI_SYNTH_SRC>,
				 <&clk CLK_AXI6>, <&clk CLK_CFG_REG_VIP>;
			clock-names = "sc_top", "clk_disp", "clk_dsi", "dsi_esc",
				      "disppll", "disp_src", "dsi_src", "esc_parent", "cfg_reg";
			status = "okay";

			port {
			};
		};
	};
};

/* NixVegas/pcb d97cfc1d2f50a0447eaf80c7d025e58900b8f5e6,
 * kicad/hdmi.kicad_sch and nixos.kicad_pcb: U16 RESET_N pin 64 has
 * R77 10k to LT8912_VDD + C47 100n to GND, with no CPU reset GPIO.
 * PWR_GPIO2 is the USER button. +1V8 feeds L4->VDD (18/33/57),
 * L3->VCCA (5/26/41/50/52), L2->VCCA_HDMIPLL (34), without enable GPIOs.
 */
/ {
	lt8912_1v8: regulator-lt8912-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "lt8912-board-1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};
};

&sophgo_dsi {
	sophgo,manual-pinstripe;
	/* Vendor dsi_phy.c:dphy_dsi_set_lane: 0=clock, 1..4=data0..3.
	 * Pad roles are physical; data-lanes below are logical DRM indices.
	 */
	sophgo,pad-roles = <1 2 0 3 4>;
	sophgo,pn-swap-mask = <0>;
	sophgo,clock-phase = <1>; /* vendor boolean: 90 degrees */
	port {
		dsi_out: endpoint {
			data-lanes = <0 1 2 3>;
			remote-endpoint = <&lt8912_in>;
		};
	};
};

&i2c2 {
	status = "okay";
	clock-frequency = <100000>;
	pinctrl-0 = <&iic2_cfg>;
	pinctrl-names = "default";
	lt8912: bridge@48 {
		compatible = "lontium,lt8912b";
		reg = <0x48>;
		status = "okay";
		lontium,rc-reset;
		vdd-supply = <&lt8912_1v8>;
		vccmipirx-supply = <&lt8912_1v8>;
		vccsysclk-supply = <&lt8912_1v8>;
		vcclvdstx-supply = <&lt8912_1v8>;
		vcchdmitx-supply = <&lt8912_1v8>;
		vcclvdspll-supply = <&lt8912_1v8>;
		vcchdmipll-supply = <&lt8912_1v8>;
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;
				lt8912_in: endpoint {
					data-lanes = <0 1 2 3>;
					remote-endpoint = <&dsi_out>;
				};
			};
			port@1 {
				reg = <1>;
				lt8912_out: endpoint {
					remote-endpoint = <&hdmi_in>;
				};
			};
		};
	};
};
/ {
	hdmi: hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";
		status = "okay";
		/* U1 39/40 and U16 61/62 share I2C_SENSOR1_SDA/SCL;
		 * FET1/FET2 translate to HDMI1 16/15. U16 receives HPD
		 * through Q12; there is no CPU HPD GPIO.
		 */
		ddc-i2c-bus = <&i2c2>;
		port {
			hdmi_in: endpoint {
				remote-endpoint = <&lt8912_out>;
			};
		};
	};
};
