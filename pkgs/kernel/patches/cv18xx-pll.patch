+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _CLK_SOPHGO_CV18XX_DSI_H_
+#define _CLK_SOPHGO_CV18XX_DSI_H_
+
+#include "clk-cv1800.h"
+#include "clk-cv18xx-common.h"
+
+/* SG2000 TRM v1.0, sophgo/sophgo-doc
+ * 370d81b365ed528dc8f5dc91f63ed445e1142d4d,
+ * SG200X/TRM/contents/cn/clock/pll_g2_registers_description.table.rst:
+ * 0x840 bit 1 is reg_dsi_ssc_syn_src_en. Bit 0 selects the shared
+ * MIPIMPLL synthesizer reference (0: half/450M, 1: full/900M).
+ * This is the source BEFORE the DSI PHY synthesizer, not the lane rate.
+ * DISPPLL bit 3 and all other synthesizers are independent owners.
+ */
+static struct cv1800_clk_regbit dsi_src_gate = CV1800_CLK_BIT(REG_PLL_G2_SSC_SYN_CTRL, 1);
+
+static int dsi_src_enable(struct clk_hw *hw)
+{
+	cv1800_clk_setbit(hw_to_cv1800_clk_common(hw), &dsi_src_gate);
+	return 0;
+}
+
+static void dsi_src_disable(struct clk_hw *hw)
+{
+	cv1800_clk_clearbit(hw_to_cv1800_clk_common(hw), &dsi_src_gate);
+}
+
+static int dsi_src_is_enabled(struct clk_hw *hw)
+{
+	return cv1800_clk_checkbit(hw_to_cv1800_clk_common(hw), &dsi_src_gate);
+}
+
+static unsigned long dsi_src_recalc_rate(struct clk_hw *hw, unsigned long parent_rate)
+{
+	struct cv1800_clk_common *common = hw_to_cv1800_clk_common(hw);
+
+	/* Read-only: never retune MIPIMPLL or the shared half/full selector. */
+	return readl(common->base + REG_PLL_G2_SSC_SYN_CTRL) & BIT(0) ? parent_rate
+								      : parent_rate / 2;
+}
+
+static const struct clk_ops cv1800_dsi_src_ops = {
+    .enable = dsi_src_enable,
+    .disable = dsi_src_disable,
+    .is_enabled = dsi_src_is_enabled,
+    .recalc_rate = dsi_src_recalc_rate,
+};
+
+#endif
