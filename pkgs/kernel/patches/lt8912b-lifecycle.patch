 static int lt8912_hard_power_on(struct lt8912 *lt)
 {
 	int ret;
 
+	/* Never release reset with a stale, failed regulator disable. */
+	if (lt->supplies_on)
+		return -EBUSY;
+	gpiod_set_value_cansleep(lt->gp_reset, 1);
 	ret = regulator_bulk_enable(ARRAY_SIZE(lt->supplies), lt->supplies);
 	if (ret)
 		return ret;
 
+	lt->supplies_on = true;
+	if (lt->pipeline)
+		lt->pipeline->supplies_owned = true;
 	gpiod_set_value_cansleep(lt->gp_reset, 0);
 	msleep(20);
 
 	return 0;
