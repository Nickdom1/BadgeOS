+/* Badge PCB d97cfc1: U16 RESET_N is R77/C47 POR, with no CPU wire.
+ * Use the golden recipe's main-bank 0x03 receiver reset on that board.
+ * This is a receiver reset, NOT a claim of power removal or physical idle.
+ */
+static int lt8912_stop(struct lt8912 *lt)
+{
+	int ret;
+	if (lt->rc_reset && lt->supplies_on) {
+		ret = regmap_write(lt->regmap[I2C_MAIN], 0x03, 0x7f);
+		if (ret) {
+			lt8912b_pipeline_error(lt->pipeline, "bridge receiver stop", ret);
+			return ret;
+		}
+	}
+	gpiod_set_value_cansleep(lt->gp_reset, 1);
+	lt->video_on = false;
+	if (lt->pipeline)
+		lt->pipeline->prepared = lt->pipeline->started = false;
+	lt->is_power_on = false;
+	return 0;
+}
+
 static void lt8912_hard_power_off(struct lt8912 *lt)
 {
-	gpiod_set_value_cansleep(lt->gp_reset, 1);
+	int ret;
+
+	if (lt8912_stop(lt))
+		return;
+	if (!lt->supplies_on)
+		return;
 	msleep(20);
-
-	regulator_bulk_disable(ARRAY_SIZE(lt->supplies), lt->supplies);
-
-	lt->is_power_on = false;
+	ret = regulator_bulk_disable(ARRAY_SIZE(lt->supplies), lt->supplies);
+	if (ret) {
+		lt8912b_pipeline_error(lt->pipeline, "bridge supplies release", ret);
+		dev_err(lt->dev, "failed to disable supplies: %d\n", ret);
+		return;
+	}
+	lt->supplies_on = false;
+	if (lt->pipeline)
+		lt->pipeline->supplies_owned = false;
 }
 
