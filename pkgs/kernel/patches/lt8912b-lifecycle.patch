+/*
+ * Host contract (Linux 7.2.2 drm_bridge.c, DSI bridge operations): the
+ * previous bridge pre_enable must prepare PHY/data LP-11 and the required
+ * clock lane before we release reset. enable starts host video before our
+ * timing/DDS latch. disable stops this receiver before host video stops;
+ * post_disable removes our supplies before the host removes the PHY.
+ * The display master must use the DRM chain helpers, including suspend /
+ * resume and teardown. Void callbacks cannot reject an atomic commit or
+ * prove upstream preparation succeeded: failures are logged and contained
+ * by reset, never advertised as initialized/video-ready. No readiness API
+ * for activating the guarded Sophgo pipeline is implied by these callbacks.
+ */
+void lt8912b_pipeline_bind(struct drm_bridge *bridge, struct lt8912b_pipeline *pipeline)
+{
+	struct lt8912 *lt = bridge_to_lt8912(bridge);
+	mutex_lock(&lt->lock);
+	lt->pipeline = pipeline;
+	mutex_unlock(&lt->lock);
+}
+EXPORT_SYMBOL_GPL(lt8912b_pipeline_bind);
+
+static void lt8912_bridge_pre_enable(struct drm_bridge *bridge)
+{
+	struct lt8912 *lt = bridge_to_lt8912(bridge);
+	int ret;
+
+	mutex_lock(&lt->lock);
+	if (lt->pipeline && (lt->pipeline->error || !lt->pipeline->host_prepared)) {
+		lt8912b_pipeline_error(lt->pipeline, "bridge prerequisite", -EACCES);
+		goto out;
+	}
+	if (lt->is_power_on)
+		goto out;
+	ret = lt8912_hard_power_on(lt);
+	if (!ret)
+		ret = lt8912_soft_power_on(lt);
+	if (ret) {
+		lt8912b_pipeline_error(lt->pipeline, "bridge prepare", ret);
+		dev_err(lt->dev, "bridge preparation failed: %d\n", ret);
+		/* Keep owned rails until ordered post_disable, even on error. */
+		lt8912_stop(lt);
+	}
+out:
+	if (lt->pipeline)
+		lt->pipeline->prepared = lt->is_power_on;
+	mutex_unlock(&lt->lock);
+}
+
 static void lt8912_bridge_enable(struct drm_bridge *bridge)
 {
 	struct lt8912 *lt = bridge_to_lt8912(bridge);
-
-	lt8912_video_on(lt);
+	int ret;
+
+	mutex_lock(&lt->lock);
+	if (lt->pipeline && (lt->pipeline->error || !lt->pipeline->host_started)) {
+		lt8912b_pipeline_error(lt->pipeline, "bridge stream prerequisite", -EACCES);
+		goto out;
+	}
+	if (!lt->is_power_on) {
+		dev_err(lt->dev, "video enable without successful preparation\n");
+		goto out;
+	}
+	if (lt->video_on)
+		goto out;
+	ret = lt8912_video_on(lt);
+	if (ret) {
+		lt8912b_pipeline_error(lt->pipeline, "bridge enable", ret);
+		dev_err(lt->dev, "video programming failed: %d\n", ret);
+		/* The host can still be streaming; defer rails to post_disable. */
+		lt8912_stop(lt);
+		goto out;
+	}
+	lt->video_on = true;
+out:
+	if (lt->pipeline)
+		lt->pipeline->started = lt->video_on;
+	mutex_unlock(&lt->lock);
+}
+
+static void lt8912_bridge_disable(struct drm_bridge *bridge)
+{
+	struct lt8912 *lt = bridge_to_lt8912(bridge);
+
+	mutex_lock(&lt->lock);
+	lt8912_stop(lt);
+	mutex_unlock(&lt->lock);
+}
+
+static void lt8912_bridge_post_disable(struct drm_bridge *bridge)
+{
+	struct lt8912 *lt = bridge_to_lt8912(bridge);
+
+	mutex_lock(&lt->lock);
+	if (lt->pipeline && lt->pipeline->host_started) {
+		lt8912b_pipeline_error(lt->pipeline, "bridge waits for host stop", -EBUSY);
+		mutex_unlock(&lt->lock);
+		return;
+	}
+	lt8912_hard_power_off(lt);
+	if (lt->supplies_on)
+		lt8912b_pipeline_error(lt->pipeline, "bridge supplies release", -EIO);
+	mutex_unlock(&lt->lock);
+}
