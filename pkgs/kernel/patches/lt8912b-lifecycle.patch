+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef DRM_LT8912B_PIPELINE_H
+#define DRM_LT8912B_PIPELINE_H
+struct drm_bridge;
+/* Caller serializes the entire chain and unbind. First error is sticky until
+ * a fully stopped retry; no software status constitutes measured output.
+ */
+struct lt8912b_pipeline {
+	int error;
+	const char *stage;
+	bool host_prepared, host_started, prepared, started, supplies_owned;
+};
+static inline void lt8912b_pipeline_error(struct lt8912b_pipeline *p, const char *stage, int error)
+{
+	if (p && error && !p->error) {
+		p->error = error;
+		p->stage = stage;
+	}
+}
+void lt8912b_pipeline_bind(struct drm_bridge *bridge, struct lt8912b_pipeline *pipeline);
+#endif
