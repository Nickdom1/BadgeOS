/dts-v1/;
#include "cv181x_base_arm.dtsi"
#include "cv181x_asic_bga.dtsi"
#include "cv181x_asic_sd.dtsi"
#include "cv181x_default_memmap.dtsi"

/ {
	model = "Milk-V DuoS";

	sd:cv-sd@4310000 {
		max-frequency = <10000000>;
	};
};

&mipi_rx {
	snsr-reset = <&porta 2 GPIO_ACTIVE_LOW>, <&porta 2 GPIO_ACTIVE_LOW>, <&porta 2 GPIO_ACTIVE_LOW>;
};

&i2c0 {
	status = "disabled";
};

&i2c1 {
	status = "okay";
};

&i2c2 {
	status = "okay";
};

&i2c3 {
	status = "okay";
};

&i2c4 {
	status = "okay";

	gt9xx: gt9xx@14 {
		compatible = "goodix,gt9xx";
		reg = <0x14>;
		goodix,irq-gpio = <&porta 18 0>;
		goodix,rst-gpio = <&porta 19 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

&spi3 {
	status = "okay";

	spidev@0 {
		status = "okay";
	};
};

&dac {
	/delete-property/ mute-gpio-l;
	/delete-property/ mute-gpio-r;
};

/* mipi dsi for u-boot.
 * BADGE: no pwm-gpio / power-ct-gpio. The dev-board values are porte 0/1,
 * which on the Nix Badge 2.0 are the IIC2 SCL/SDA pads wired to the LT8912B
 * HDMI bridge; letting vo/mipi_tx claim them as GPIOs kills the bridge's I2C
 * bus (the Debian rig fights this at runtime with cvi-pinmux re-asserts —
 * archive GOLDEN-first-hdmi-out.md fix #2). The driver treats the absent properties
 * as -EINVAL and skips them (vo_mipi_tx.c of_get_named_gpio_flags fallback).
 */
&vo {
	compatible = "cvitek,vo";
	reset-gpio = <&porte 2 GPIO_ACTIVE_LOW>;
	/* the base dtsi (cv181x_base.dtsi &vo) sets these; deleting the
	 * re-statement is not enough — delete the inherited properties */
	/delete-property/ pwm-gpio;
	/delete-property/ power-ct-gpio;
	status = "okay";
};

/* mipi dsi for kernel — same badge pad note as &vo above */
&mipi_tx {
	compatible = "cvitek,mipi_tx";
	reset-gpio = <&porte 2 GPIO_ACTIVE_LOW>;
	/delete-property/ pwm-gpio;
	/delete-property/ power-ct-gpio;
	status = "okay";
};

&wifisd {
	status = "okay";
	cap-sd-highspeed;
	sd-uhs-sdr25;
	sd-uhs-ddr50;
	sd-uhs-sdr104;
	min-frequency = <400000>;
	max-frequency = <187500000>;
};

&wifi_pin {
	status = "okay";
	compatible = "cvitek,wifi-pin";
	poweron-gpio = <&porta 15 GPIO_ACTIVE_HIGH>;
	wakeup-gpio = <&porte 7 GPIO_ACTIVE_HIGH>;
};

&usb {
	vbus-gpio = <&portb 6 0>;
};

&uart1 {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&uart3 {
	status = "okay";
};

&uart4 {
	status = "okay";
};
