+static int sophgo_dsi_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct sophgo_dsi *dsi;
+	struct resource *res;
+	struct sophgo_host_bridge *host_bridge;
+	int i, ret;
+
+	dsi = devm_kzalloc(dev, sizeof(*dsi), GFP_KERNEL);
+	if (!dsi)
+		return -ENOMEM;
+	platform_set_drvdata(pdev, dsi);
+	mutex_init(&dsi->host_lock);
+	mutex_init(&dsi->commit_lock);
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "sc_top");
+	if (!res || resource_size(res) < SOPHGO_SC_TOP_SIZE)
+		return dev_err_probe(dev, -EINVAL, "sc_top resource missing or too small\n");
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "disp");
+	if (!res || resource_size(res) < SOPHGO_DISP_SIZE)
+		return dev_err_probe(dev, -EINVAL, "disp resource missing or too small\n");
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "dphy");
+	if (!res || resource_size(res) < SOPHGO_DPHY_SIZE)
+		return dev_err_probe(dev, -EINVAL, "dphy resource missing or too small\n");
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "dsi_mac");
+	if (!res || resource_size(res) < SOPHGO_MAC_SIZE)
+		return dev_err_probe(dev, -EINVAL, "dsi_mac resource missing or too small\n");
+	for (i = 0; i < ARRAY_SIZE(resource_names); i++) {
+		dsi->regs[i] = devm_platform_ioremap_resource_byname(pdev, resource_names[i]);
+		if (IS_ERR(dsi->regs[i]))
+			return PTR_ERR(dsi->regs[i]);
+	}
+	/* VIP is shared with capture/scaler: do not claim its MMIO window.
+	 * The DT syscon serializes local masked writes; never use RST_VIPSYS.
+	 * Acquire clocks without touching hardware; activation remains gated.
+	 */
+	ret = sophgo_mac_init(&dsi->mac, dsi->regs[SOPHGO_DSI_MAC], resource_size(res));
+	if (ret)
+		return ret;
+	dsi->mac.eot = !mac_no_eot; /* default: EoT on, matching golden Debian */
+	dsi->mac.fire_and_forget = mac_fire_and_forget; /* vendor fire-and-forget HS */
+	if (vip_bt_clock) {
+		ret = sophgo_bt_clock_get(dev, &dsi->clocks.bt);
+		if (ret)
+			return dev_err_probe(dev, ret, "clk_bt_vip unavailable from the host clock provider\n");
+	}
+	ret = sophgo_clocks_get(dev, &dsi->clocks);
+	if (ret)
+		return dev_err_probe(dev, ret, "display clocks unavailable\n");
+	ret = sophgo_vip_get(dev, &dsi->vip, &dsi->clocks);
+	if (ret)
+		return dev_err_probe(dev, ret, "shared VIP owner unavailable\n");
+	dsi->esc_parent = devm_clk_get(dev, "esc_parent");
+	if (IS_ERR(dsi->esc_parent))
+		return PTR_ERR(dsi->esc_parent);
+	dsi->pipeline.mac = &dsi->mac;
+	dsi->pipeline.start_failure = sophgo_mac_start_failure;
+	dsi->pipeline.disp = dsi->regs[SOPHGO_DISP];
+	dsi->pipeline.link = (struct sophgo_link){.clocks = &dsi->clocks,
+						  .vip = &dsi->vip,
+						  .phy = dsi->regs[SOPHGO_DPHY],
+						  .top = dsi->regs[SOPHGO_SC_TOP]};
+	ret = sophgo_graph_get(dev, &dsi->bridge_node, &dsi->lane_config);
+	if (ret)
+		return dev_err_probe(dev, ret, "invalid or nondeployable display graph\n");
+	host_bridge = devm_drm_bridge_alloc(dev, struct sophgo_host_bridge, bridge,
+					    &sophgo_host_bridge_funcs);
+	if (IS_ERR(host_bridge)) {
+		of_node_put(dsi->bridge_node);
+		return PTR_ERR(host_bridge);
+	}
+	host_bridge->dsi = dsi;
+	dsi->host_bridge = &host_bridge->bridge;
+	ret = devm_drm_bridge_add(dev, dsi->host_bridge);
+	if (ret) {
+		of_node_put(dsi->bridge_node);
+		return ret;
+	}
+	dsi->manual_selected = of_property_read_bool(dev->of_node, "sophgo,manual-pinstripe");
+	if (dsi->manual_selected && pinstripe_trace) {
+		dsi->pipeline.link.trace.ctx = dsi;
+		dsi->pipeline.link.trace.emit = sophgo_pinstripe_trace;
+		ret = sophgo_dump_setup(dsi, pdev);
+		if (ret) {
+			of_node_put(dsi->bridge_node);
+			return ret;
+		}
+		/* The empty ring is always published for the boot gate; only an
+		 * explicit opt-in lets the pipeline fill it.
+		 */
+		if (pinstripe_snapshot)
+			dsi->pipeline.snapshot = sophgo_pipeline_snapshot;
+	}
+	dsi->host.dev = dev;
+	dsi->host.ops = &sophgo_dsi_host_ops;
+	ret = mipi_dsi_host_register(&dsi->host);
+	if (ret)
+		of_node_put(dsi->bridge_node);
+	return ret;
+}
+
+static int sophgo_kms_create(struct sophgo_dsi *dsi)
+{
+	static const u32 formats[] = {DRM_FORMAT_XRGB8888};
+	struct drm_device *drm;
+	struct sophgo_kms *kms;
+	int ret;
+
+	drm = drm_dev_alloc(&sophgo_dsi_driver, dsi->host.dev);
+	if (IS_ERR(drm))
+		return PTR_ERR(drm);
+	kms = drmm_kzalloc(drm, sizeof(*kms), GFP_KERNEL);
+	if (!kms) {
+		drm_dev_put(drm);
+		return -ENOMEM;
+	}
+	kms->dsi = dsi;
+	mutex_init(&kms->release_lock);
+	drm->dev_private = kms;
+	ret = drmm_mode_config_init(drm);
+	if (ret)
+		goto put;
+	drm->mode_config.funcs = &sophgo_mode_config_funcs;
+	drm->mode_config.min_width = 1;
+	drm->mode_config.min_height = 1;
+	drm->mode_config.max_width = 1920;
+	drm->mode_config.max_height = 1080;
+	ret = drm_universal_plane_init(drm, &kms->plane, 1, &sophgo_plane_funcs, formats,
+				       ARRAY_SIZE(formats), NULL, DRM_PLANE_TYPE_PRIMARY, NULL);
+	if (ret)
+		goto put;
+	drm_plane_helper_add(&kms->plane, &sophgo_plane_helpers);
+	ret =
+	    drm_crtc_init_with_planes(drm, &kms->crtc, &kms->plane, NULL, &sophgo_crtc_funcs, NULL);
+	if (ret)
+		goto put;
+	drm_crtc_helper_add(&kms->crtc, &sophgo_crtc_helpers);
+	ret =
+	    drm_encoder_init(drm, &kms->encoder, &sophgo_encoder_funcs, DRM_MODE_ENCODER_DSI, NULL);
+	if (ret)
+		goto put;
+	kms->encoder.possible_crtcs = drm_crtc_mask(&kms->crtc);
+	/* The I2C bridge must not own an object retained by a DRM file. */
+	ret = sophgo_pipeline_attach(dsi, &kms->encoder);
+	if (ret)
+		goto put;
+	ret = drm_connector_init(drm, &kms->connector, &sophgo_connector_funcs,
+				 DRM_MODE_CONNECTOR_HDMIA);
+	if (ret)
+		goto put;
+	drm_connector_helper_add(&kms->connector, &sophgo_connector_helpers);
+	ret = drm_connector_attach_encoder(&kms->connector, &kms->encoder);
+	if (ret)
+		goto put;
+	drm_mode_config_reset(drm);
+	/* Registration can expose a minor before a later sysfs step fails.
+	 * Even that failure must drain operations and detach the bridge now.
+	 */
+	dsi->drm = drm;
+	ret = drm_dev_register(drm, 0);
+	if (ret) {
+		sophgo_kms_destroy(dsi);
+		return ret;
+	}
+	return 0;
+put:
+	drm_dev_put(drm);
+	return ret;
+}
+
+/* The sysfs write returns the pipeline errno, not a void DRM callback result.
+ * Lock order matches detach: host -> commit. Status takes only commit so it
+ * remains readable during terminal containment. No boot service writes here.
+ */
+static ssize_t pinstripe_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct sophgo_dsi *dsi = dev_get_drvdata(dev);
+	struct sophgo_pipeline *p = &dsi->pipeline;
+	ssize_t ret;
+	mutex_lock(&dsi->commit_lock);
+	ret = sysfs_emit(buf, "selected=%u terminal=%u started=%u owned=%u stage=%s error=%d\n",
+		dsi->manual_selected, dsi->terminal, p->status.started,
+		sophgo_pipeline_owned(p), p->status.stage ?: "idle", p->status.error);
+	mutex_unlock(&dsi->commit_lock);
+	return ret;
+}
+
+static ssize_t pinstripe_store(struct device *dev, struct device_attribute *attr,
+			      const char *buf, size_t count)
+{
+	struct sophgo_dsi *dsi = dev_get_drvdata(dev);
+	struct sophgo_pipeline *p = &dsi->pipeline;
+	bool start = sysfs_streq(buf, "start");
+	int ret;
+	if (!start && !sysfs_streq(buf, "stop"))
+		return -EINVAL;
+	if (!dsi->manual_selected)
+		return -EOPNOTSUPP;
+	if (p->link.trace.emit)
+		dev_err(dsi->host.dev, "pinstripe trace waiting: host lock\n");
+	mutex_lock(&dsi->host_lock);
+	if (p->link.trace.emit)
+		dev_err(dsi->host.dev, "pinstripe trace waiting: commit lock\n");
+	mutex_lock(&dsi->commit_lock);
+	if (p->link.trace.emit)
+		dev_err(dsi->host.dev, "pinstripe trace acquired: commit lock\n");
+	if (!dsi->drm || !dsi->peripheral || dsi->terminal) {
+		ret = -ENODEV;
+		goto out;
+	}
+	if (!start) {
+		ret = SOPHGO_TRACE_VALUE(&p->link.trace, "sophgo_pipeline_manual_stop",
+					 sophgo_pipeline_manual_stop(p, dsi->host_bridge));
+		if (!ret)
+			dsi->manual_request = false;
+		goto out;
+	}
+	ret = sophgo_pipeline_retry(p);
+	if (ret)
+		goto out;
+	dsi->manual_request = true;
+	SOPHGO_TRACE_VOID(
+	    &p->link.trace, "drm_bridge_chain_mode_set",
+	    drm_bridge_chain_mode_set(dsi->host_bridge, &sophgo_golden_mode, &sophgo_golden_mode));
+	SOPHGO_TRACE_VOID(&p->link.trace, "drm_atomic_bridge_chain_pre_enable",
+			  drm_atomic_bridge_chain_pre_enable(dsi->host_bridge, NULL));
+	SOPHGO_TRACE_VOID(&p->link.trace, "drm_atomic_bridge_chain_enable",
+			  drm_atomic_bridge_chain_enable(dsi->host_bridge, NULL));
+	ret = SOPHGO_TRACE_VALUE(&p->link.trace, "sophgo_pipeline_complete",
+				 sophgo_pipeline_complete(p, dsi->host_bridge));
+	if (!ret && !p->status.started) {
+		lt8912b_pipeline_error(&p->status, "bridge did not start", -EIO);
+		ret = SOPHGO_TRACE_VALUE(&p->link.trace, "sophgo_pipeline_complete",
+					 sophgo_pipeline_complete(p, dsi->host_bridge));
+	}
+	/* The counterpart of the locked Debian dump: host and bridge both started. */
+	if (!ret && p->status.started && p->snapshot)
+		p->snapshot(p, "complete");
+	if (!sophgo_pipeline_owned(p))
+		dsi->manual_request = false;
+ out:
+	mutex_unlock(&dsi->commit_lock);
+	mutex_unlock(&dsi->host_lock);
+	return ret ? ret : (ssize_t)count;
+}
+/* Independent pointer snapshots, not a coherent ownership/status report.
+ * Readable while start holds commit_lock. Nested calls may leave entered
+ * and returned naming different levels; console pairs show the full order.
+ * If the CPU/bus is wedged, only the already emitted serial bytes survive.
+ */
+static ssize_t pinstripe_progress_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct sophgo_dsi *dsi = dev_get_drvdata(dev);
+	struct sophgo_trace *trace = &dsi->pipeline.link.trace;
+	const char *entered = READ_ONCE(trace->entered);
+	const char *returned = READ_ONCE(trace->returned);
+
+	return sysfs_emit(buf, "enabled=%u entered=%s returned=%s\n", !!trace->emit,
+			  entered ?: "idle", returned ?: "none");
+}
+static DEVICE_ATTR_RO(pinstripe_progress);
+static DEVICE_ATTR_RW(pinstripe);
+static struct attribute *sophgo_attrs[] = {&dev_attr_pinstripe.attr,
+					   &dev_attr_pinstripe_progress.attr, NULL};
+ATTRIBUTE_GROUPS(sophgo);
+
+static void sophgo_dsi_remove(struct platform_device *pdev)
+{
+	struct sophgo_dsi *dsi = platform_get_drvdata(pdev);
+
+	mipi_dsi_host_unregister(&dsi->host);
+	of_node_put(dsi->bridge_node);
+}
+
+static void sophgo_dsi_shutdown(struct platform_device *pdev)
+{
+	struct sophgo_dsi *dsi = platform_get_drvdata(pdev);
+
+	mutex_lock(&dsi->host_lock);
+	if (dsi->drm)
+		sophgo_kms_destroy(dsi);
+	mutex_unlock(&dsi->host_lock);
+}
+
+static int sophgo_dsi_suspend(struct device *dev) { return -EOPNOTSUPP; }
+static const struct dev_pm_ops sophgo_dsi_pm = {
+    .suspend = sophgo_dsi_suspend,
+    .freeze = sophgo_dsi_suspend,
+    .poweroff = sophgo_dsi_suspend,
+};
+
+static const struct of_device_id sophgo_dsi_of_match[] = {{.compatible = "sophgo,sg2000-dsi"}, {}};
+MODULE_DEVICE_TABLE(of, sophgo_dsi_of_match);
+
+static struct platform_driver sophgo_dsi_platform_driver = {
+    .probe = sophgo_dsi_probe,
+    .remove = sophgo_dsi_remove,
+    .shutdown = sophgo_dsi_shutdown,
+    .driver =
+	{
+	    .name = "sophgo-dsi",
+	    .dev_groups = sophgo_groups,
+	    .pm = &sophgo_dsi_pm,
+	    .of_match_table = sophgo_dsi_of_match,
+	},
+};
+module_platform_driver(sophgo_dsi_platform_driver);
+
+MODULE_DESCRIPTION("Sophgo SG2000 DRM / video-only DSI skeleton");
+MODULE_AUTHOR("BadgeOS contributors");
+MODULE_LICENSE("GPL");
diff --git a/interdrv/sophgo-dsi/sophgo-dump.h b/interdrv/sophgo-dsi/sophgo-dump.h
new file mode 100644
--- /dev/null
+++ b/interdrv/sophgo-dsi/sophgo-dump.h
@@ -0,0 +1,232 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SOPHGO_DUMP_H
+#define SOPHGO_DUMP_H
+
+#include "sophgo-trace.h"
+
+/*
+ * Fenced register snapshots for the golden-Debian comparison.
+ *
+ * Morgan's Debian dump (dbg-locked.tgz, taken after `recipe.sh 11 6` once the
+ * bridge is locked) reads one 4 KiB page each of scaler_top 0x0a080000, disp
+ * 0x0a088000, dsi_mac 0x0a08a000, vip_sys 0x0a0c8000 and clk_ctrl 0x03002000
+ * through /dev/mem, and deliberately excludes the D-PHY page 0x0a0d1000: a raw
+ * userspace read of it wedged that badge before. Those first five blocks are
+ * captured here in the same order, so `xxd`-formatted pages diff directly
+ * against his files.
+ *
+ * A sixth block, dphy, is read ONLY under a second supervised
+ * opt-in (module param pinstripe_dphy). It is NOT the userspace mmap that
+ * wedged Debian: it is an in-kernel readl of the driver's OWN already-mapped
+ * `dsi->regs[SOPHGO_DPHY]` window, taken while sophgo_link owns the clocks
+ * (cfg_reg held) — the exact base and ownership under which the driver already
+ * writes the PLL and lanes every start (sophgo-dphy.h set_pll/set_lanes). It is
+ * fenced to the mapped register span 0x00-0xc8 (SOPHGO_DUMP_FENCE_DPHY),
+ * including EN/HS/PLL/UPDATE/SET/MAP/PN and lane-state words. The vendor
+ * dphy_get_dsi_lane_status reads the lane state; individual state bits and
+ * offset 0x34 remain undocumented. Matching values alone do not prove payload.
+ *
+ * On this mainline image the userspace route is neither possible nor safe:
+ * CONFIG_IO_STRICT_DEVMEM refuses driver-claimed windows, and bring-up trials
+ * showed VIP-domain register accesses stalling once CLK_CFG_REG_VIP is
+ * released. Snapshots therefore run only while sophgo_link owns the clocks
+ * (cfg_reg, sc_top, clk_disp, clk_dsi) and copy into memory; the debugfs
+ * reader never touches hardware. The shared VIP syscon is read only through
+ * its regmap, which holds cfg_reg around each access. The D-PHY block is read
+ * only under the pinstripe_dphy opt-in and only for its fenced 0x00-0xc8 span
+ * (see above). A snapshot is diagnostic evidence, never acceptance.
+ *
+ * Every page is FENCED. An unfenced "prepared" capture wedged the SoC:
+ * it read all 1024 words of every
+ * page, and the golden dump's clk_ctrl.missing had already shown clock-
+ * controller offsets 0xb00-0xffc to be bus-unreadable (a kernel-mode access
+ * there hangs the C906 silently, no oops). Each block is now read only up to
+ * the extent the vendor HAL documents for it, bounded by what the golden dump
+ * proved readable; the remainder of each page stays zero and the fence is
+ * published in the header so the reader can tell "zero" from "not read".
+ * Each block read is bracketed by trace marks so any future stall names the
+ * page instead of the whole capture.
+ */
+#define SOPHGO_DUMP_PAGE 0x1000U
+#define SOPHGO_DUMP_WORDS (SOPHGO_DUMP_PAGE / 4)
+#define SOPHGO_DUMP_BLOCKS 6
+#define SOPHGO_DUMP_SLOTS 3
+#define SOPHGO_DUMP_MAGIC 0x50444753U /* "SGDP" as a little-endian word */
+#define SOPHGO_DUMP_VERSION 3U
+#define SOPHGO_DUMP_LABEL 24
+#define SOPHGO_DUMP_NAME 12
+
+enum sophgo_dump_block {
+	SOPHGO_DUMP_SC_TOP,
+	SOPHGO_DUMP_DISP,
+	SOPHGO_DUMP_DSI_MAC,
+	SOPHGO_DUMP_VIP_SYS,
+	SOPHGO_DUMP_CLK_CTRL,
+	SOPHGO_DUMP_DPHY,
+};
+
+/*
+ * Words read from offset 0 of each block. Provenance (pinned osdrv HAL
+ * aa542c41 and Morgan's locked Debian register capture):
+ *  scaler_top 0x000-0x0fc: scaler_reg.h REG_SCL_TOP_* ends at VO_MUX1 0x94.
+ *  disp       0x000-0x3fc: reg_disp.h ends at DISP_REG_TGEN_LITE_HS 0x314.
+ *  dsi_mac    0x000-0x03c: MAC_EN/HS_0/HS_1/ESC 0x00-0x0c, ESC_TX0-3 0x10-0x1c,
+ *             ESC_RX0/1 0x20-0x24 (scaler_reg.h REG_SCL_DSI_*); golden shows
+ *             nothing past 0x24.
+ *  vip_sys    0x000-0x0fc: reg_vip_sys.h ends at VIP_OFF_AXI_MON_M7 0xe0.
+ *  clk_ctrl   0x000-0xafc: golden read these without error; clk_ctrl.missing
+ *             lists 0xb00-0xffc (320 words) as bus-unreadable. Never widen
+ *             this fence without new hardware evidence.
+ * Golden also holds non-zero words past these extents on scaler_top
+ * (0x100-0x318, 0xc00-0xc08) and disp (0x908, 0x914); they are undocumented
+ * in the HAL and stay unread until a fenced capture is proven on this image.
+ */
+#define SOPHGO_DUMP_FENCE_SC_TOP 64U
+#define SOPHGO_DUMP_FENCE_DISP 256U
+#define SOPHGO_DUMP_FENCE_DSI_MAC 16U
+#define SOPHGO_DUMP_FENCE_VIP_SYS 64U
+#define SOPHGO_DUMP_FENCE_CLK_CTRL 704U
+/*
+ *  dphy       0x000-0x0c8: the full mapped D-PHY window (SOPHGO_DPHY_SIZE 0xcc,
+ *             51 words). 0x00-0xa0 are the registers our set_pll/set_lanes/set_hs
+ *             write and the vendor dphy HAL reads (EN 0x00, HS 0x14, PLL 0x6c,
+ *             UPDATE 0x8c, SET 0x90, MAP 0x9c, PN 0xa0). Supervised trials read
+ *             the complete span in-kernel while clocks were owned. The meaning
+ *             of undocumented status and PLL bits is not inferred here. Reads
+ *             stay inside the ioremapped 0xcc resource. Read ONLY under pinstripe_dphy.
+ */
+#define SOPHGO_DUMP_FENCE_DPHY 51U
+
+struct sophgo_dump_slot {
+	char label[SOPHGO_DUMP_LABEL];
+	unsigned long long ns; /* ktime_get_ns() at capture */
+	int error;	       /* first regmap error, if any */
+	unsigned int valid;    /* one bit per captured block */
+};
+
+/* Fixed little-endian layout read by tools/hdmi-rig/pinstripe-registers.py.
+ * Version 2 inserted fence[] (words read per block) and reserved[] after name[]
+ * to keep the slot array 8-byte aligned. Version 3 adds the sixth (dphy) block:
+ * with BLOCKS=6 the pre-slot header is 24+24+72+24 = 144 bytes, so reserved[2]
+ * (8 bytes) holds the 8-byte alignment and the header is 152 + slot[3] = 272
+ * bytes, then slots x blocks x 4 KiB pages.
+ */
+struct sophgo_dump {
+	unsigned int magic, version, page, blocks, slots, next;
+	unsigned int phys[SOPHGO_DUMP_BLOCKS];
+	char name[SOPHGO_DUMP_BLOCKS][SOPHGO_DUMP_NAME];
+	unsigned int fence[SOPHGO_DUMP_BLOCKS];
+	unsigned int reserved[2];
+	struct sophgo_dump_slot slot[SOPHGO_DUMP_SLOTS];
+	unsigned int word[SOPHGO_DUMP_SLOTS][SOPHGO_DUMP_BLOCKS][SOPHGO_DUMP_WORDS];
+};
+_Static_assert(sizeof(struct sophgo_dump_slot) == 40, "slot layout is part of the blob ABI");
+_Static_assert(sizeof(struct sophgo_dump) == 272 + SOPHGO_DUMP_SLOTS * SOPHGO_DUMP_BLOCKS * SOPHGO_DUMP_PAGE,
+	       "dump layout is part of the blob ABI");
+
+/* page[SOPHGO_DUMP_VIP_SYS] is ignored: the syscon is never mapped privately. */
+struct sophgo_dump_sources {
+	void __iomem *page[SOPHGO_DUMP_BLOCKS];
+	struct regmap *vip;
+};
+
+static inline void sophgo_dump_copy_name(char *dst, unsigned int size, const char *src)
+{
+	unsigned int i;
+
+	for (i = 0; i < size; i++)
+		dst[i] = 0;
+	for (i = 0; i + 1 < size && src[i]; i++)
+		dst[i] = src[i];
+}
+
+static inline void sophgo_dump_init(struct sophgo_dump *d, const unsigned int phys[SOPHGO_DUMP_BLOCKS])
+{
+	static const char *const names[SOPHGO_DUMP_BLOCKS] = {
+	    "scaler_top", "disp", "dsi_mac", "vip_sys", "clk_ctrl", "dphy",
+	};
+	static const unsigned int fence[SOPHGO_DUMP_BLOCKS] = {
+	    SOPHGO_DUMP_FENCE_SC_TOP,  SOPHGO_DUMP_FENCE_DISP,	 SOPHGO_DUMP_FENCE_DSI_MAC,
+	    SOPHGO_DUMP_FENCE_VIP_SYS, SOPHGO_DUMP_FENCE_CLK_CTRL, SOPHGO_DUMP_FENCE_DPHY,
+	};
+	unsigned int i;
+
+	memset(d, 0, sizeof(*d));
+	d->magic = SOPHGO_DUMP_MAGIC;
+	d->version = SOPHGO_DUMP_VERSION;
+	d->page = SOPHGO_DUMP_PAGE;
+	d->blocks = SOPHGO_DUMP_BLOCKS;
+	d->slots = SOPHGO_DUMP_SLOTS;
+	for (i = 0; i < SOPHGO_DUMP_BLOCKS; i++) {
+		d->phys[i] = phys[i];
+		d->fence[i] = fence[i];
+		sophgo_dump_copy_name(d->name[i], SOPHGO_DUMP_NAME, names[i]);
+	}
+}
+
+/*
+ * Fill the next ring slot. The caller passes `owned` from the pipeline's own
+ * clock ownership; without it nothing is read and -EACCES is returned, so no
+ * path can turn this into an unclocked access. Only fence[b] words of each
+ * block are read (a fence above the page refuses the whole capture with
+ * -EINVAL before any access). Unmapped blocks are skipped; a regmap failure
+ * is retained in the slot and returned after the other blocks are still
+ * captured. Every block read is bracketed by trace marks (labels have module
+ * lifetime). Never called from IRQ or polling contexts.
+ */
+static inline int sophgo_dump_capture(struct sophgo_dump *d, const struct sophgo_dump_sources *s,
+				      const char *label, bool owned, unsigned long long ns,
+				      struct sophgo_trace *trace)
+{
+	static const char *const marks[SOPHGO_DUMP_BLOCKS] = {
+	    "snapshot scaler_top", "snapshot disp",     "snapshot dsi_mac",
+	    "snapshot vip_sys",    "snapshot clk_ctrl", "snapshot dphy",
+	};
+	struct sophgo_dump_slot *slot;
+	unsigned int(*words)[SOPHGO_DUMP_WORDS];
+	unsigned int index, b, w;
+	int ret = 0;
+
+	if (!d || !s || !label || d->magic != SOPHGO_DUMP_MAGIC)
+		return -EINVAL;
+	for (b = 0; b < SOPHGO_DUMP_BLOCKS; b++)
+		if (d->fence[b] > SOPHGO_DUMP_WORDS)
+			return -EINVAL;
+	if (!owned)
+		return -EACCES;
+	index = d->next % SOPHGO_DUMP_SLOTS;
+	slot = &d->slot[index];
+	words = d->word[index];
+	memset(words, 0, sizeof(d->word[index]));
+	sophgo_dump_copy_name(slot->label, SOPHGO_DUMP_LABEL, label);
+	slot->ns = ns;
+	slot->error = 0;
+	slot->valid = 0;
+	for (b = 0; b < SOPHGO_DUMP_BLOCKS; b++) {
+		if (b == SOPHGO_DUMP_VIP_SYS) {
+			int err;
+
+			if (!s->vip)
+				continue;
+			sophgo_trace_mark(trace, marks[b], false);
+			err = regmap_bulk_read(s->vip, 0, words[b], d->fence[b]);
+			sophgo_trace_mark(trace, marks[b], true);
+			if (err) {
+				slot->error = err;
+				ret = err;
+				continue;
+			}
+		} else {
+			if (!s->page[b])
+				continue;
+			sophgo_trace_mark(trace, marks[b], false);
+			for (w = 0; w < d->fence[b]; w++)
+				words[b][w] = readl(s->page[b] + 4 * w);
+			sophgo_trace_mark(trace, marks[b], true);
+		}
+		slot->valid |= 1U << b;
+	}
+	d->next++;
+	return ret;
+}
+#endif
diff --git a/interdrv/sophgo-dsi/sophgo-graph.h b/interdrv/sophgo-dsi/sophgo-graph.h
new file mode 100644
--- /dev/null
+++ b/interdrv/sophgo-dsi/sophgo-graph.h
@@ -0,0 +1,80 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SOPHGO_GRAPH_H
+#define SOPHGO_GRAPH_H
+
+/* Desk board contract: DRM lanes are logical data0..3, not PHY pad roles.
+ * Require exact lengths: of_property_read_u32_array alone accepts extras.
+ */
+static int sophgo_graph_lanes(struct device_node *ep, u32 lanes[4])
+{
+	unsigned int i;
+
+	if (of_property_count_u32_elems(ep, "data-lanes") != 4 ||
+	    of_property_read_u32_array(ep, "data-lanes", lanes, 4))
+		return -EINVAL;
+	for (i = 0; i < 4; i++)
+		if (lanes[i] != i)
+			return -EINVAL;
+	return 0;
+}
+
+static int sophgo_graph_get(struct device *dev, struct device_node **bridge_node,
+			    struct sophgo_dphy_lanes *config)
+{
+	static const char *const supplies[] = {
+	    "vdd-supply",	"vccmipirx-supply",  "vccsysclk-supply",  "vcclvdstx-supply",
+	    "vcchdmitx-supply", "vcclvdspll-supply", "vcchdmipll-supply",
+	};
+	struct device_node *ep, *remote = NULL, *back = NULL, *bridge = NULL;
+	struct device_node *supply;
+	u32 lanes[4], roles[5], pn, phase;
+	int ret = -EINVAL;
+	unsigned int i;
+
+	ep = of_graph_get_endpoint_by_regs(dev->of_node, 0, -1);
+	if (!ep)
+		return -ENODEV;
+	remote = of_graph_get_remote_endpoint(ep);
+	if (!remote)
+		goto out;
+	back = of_graph_get_remote_endpoint(remote);
+	bridge = of_graph_get_port_parent(remote);
+	if (back != ep || !bridge || !of_device_is_compatible(bridge, "lontium,lt8912b") ||
+	    sophgo_graph_lanes(ep, lanes) || sophgo_graph_lanes(remote, lanes))
+		goto out;
+	if (of_property_count_u32_elems(dev->of_node, "sophgo,pad-roles") != 5 ||
+	    of_property_read_u32_array(dev->of_node, "sophgo,pad-roles", roles, 5) ||
+	    of_property_count_u32_elems(dev->of_node, "sophgo,pn-swap-mask") != 1 ||
+	    of_property_read_u32(dev->of_node, "sophgo,pn-swap-mask", &pn) ||
+	    of_property_count_u32_elems(dev->of_node, "sophgo,clock-phase") != 1 ||
+	    of_property_read_u32(dev->of_node, "sophgo,clock-phase", &phase) ||
+	    sophgo_dphy_calc_lanes(roles, pn, phase, 0, config) || config->count != 4)
+		goto out;
+	/* No real reset/rail net is established by the golden recipe. A mere
+	 * status override must not turn this checked-in desk fixture into a
+	 * driver that acquires dummy regulators or asserts the USER button.
+	 */
+	if (of_property_present(dev->of_node, "sophgo,desk-only")) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	if (!of_device_is_available(bridge) || (!of_property_present(bridge, "reset-gpios") &&
+	    !of_property_present(bridge, "lontium,rc-reset")))
+		goto out;
+	for (i = 0; i < ARRAY_SIZE(supplies); i++) {
+		supply = of_parse_phandle(bridge, supplies[i], 0);
+		if (!supply)
+			goto out;
+		of_node_put(supply);
+	}
+	*bridge_node = bridge;
+	bridge = NULL;
+	ret = 0;
+out:
+	of_node_put(bridge);
+	of_node_put(back);
+	of_node_put(remote);
+	of_node_put(ep);
+	return ret;
+}
+#endif
diff --git a/interdrv/sophgo-dsi/sophgo-link.h b/interdrv/sophgo-dsi/sophgo-link.h
new file mode 100644
--- /dev/null
+++ b/interdrv/sophgo-dsi/sophgo-link.h
@@ -0,0 +1,340 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SOPHGO_LINK_H
+#define SOPHGO_LINK_H
+
+/* Caller holds the DRM/host configuration lock across prepare, bridge setup,
+ * video and stop. Never set pipeline_ready here.
+ * The MAC owner supplies start/idle callbacks: idle must stop display tgen and drain/ack the MAC
+ * stop, including after a failed start. No clocks may go away on idle failure.
+ */
+struct sophgo_link_rate {
+	struct sophgo_trace *trace;
+	struct clk *clk, *parent;
+	unsigned long rate;
+	bool held, dirty;
+};
+
+struct sophgo_link {
+	struct sophgo_trace trace;
+	struct sophgo_clocks *clocks;
+	struct sophgo_vip *vip;
+	void __iomem *phy, *top;
+	struct sophgo_link_rate escape;
+	struct sophgo_dphy_lanes lanes;
+	unsigned int vip_div_saved;
+	bool vip_div_owned;
+	bool pll_held, source_held, clocks_owned, phy_owned, lp11_programmed, video_owned,
+	    video_started;
+	unsigned long esc_hz, pll_hz, source_hz;
+	struct clk *esc_parent;
+	int (*video)(void *ctx, bool enable);
+	void *video_ctx;
+};
+
+/* Local CCF setters can return success without applying the requested rate.
+ * 1 ppm is a desk arithmetic bound, NOT a measured source/lane tolerance.
+ */
+static inline bool sophgo_link_rate_matches(unsigned long got, unsigned long want)
+{
+	unsigned long delta = got > want ? got - want : want - got;
+
+	return got && want && delta <= want / 1000000;
+}
+
+static inline int sophgo_link_ready(struct sophgo_link *link)
+{
+	unsigned long rate;
+	int ret;
+
+	/* Preserve the acquired shared PLL rate, not an invented 594 MHz target.
+	 * The patched recalc is zero on power-down, missing lock or update-busy.
+	 * This does not settle the XOR/W1T latch question.
+	 */
+	ret = SOPHGO_TRACE_VALUE(&link->trace, "read_poll_timeout",
+				 read_poll_timeout(clk_get_rate, rate,
+						   sophgo_link_rate_matches(rate, link->pll_hz),
+						   100, 200000, false, link->clocks->bulk[4].clk));
+	if (ret)
+		return ret;
+	if (SOPHGO_TRACE_VALUE(&link->trace, "clk_get_rate",
+			       clk_get_rate(link->clocks->bulk[6].clk)) != link->source_hz ||
+	    !sophgo_link_rate_matches(
+		SOPHGO_TRACE_VALUE(&link->trace, "clk_get_rate", clk_get_rate(link->escape.clk)),
+		link->esc_hz) ||
+	    !clk_is_match(SOPHGO_TRACE_VALUE(&link->trace, "clk_get_parent",
+					     clk_get_parent(link->escape.clk)),
+			  link->esc_parent))
+		return -ERANGE;
+	return 0;
+}
+
+static inline int sophgo_link_rate_set(struct sophgo_link_rate *save, struct clk *clk,
+				       struct clk *parent, unsigned long rate)
+{
+	long rounded;
+	int ret =
+	    SOPHGO_TRACE_VALUE(save->trace, "clk_rate_exclusive_get", clk_rate_exclusive_get(clk));
+
+	if (ret)
+		return ret;
+	save->clk = clk;
+	save->held = true;
+	save->parent = SOPHGO_TRACE_VALUE(save->trace, "clk_get_parent", clk_get_parent(clk));
+	save->rate = SOPHGO_TRACE_VALUE(save->trace, "clk_get_rate", clk_get_rate(clk));
+	if (!save->parent || !save->rate)
+		return -ERANGE;
+	/* Mark before setters: CCF may hide provider errors after mutation. */
+	save->dirty = true;
+	ret = SOPHGO_TRACE_VALUE(save->trace, "clk_set_parent", clk_set_parent(clk, parent));
+	if (ret)
+		return ret;
+	rounded = SOPHGO_TRACE_VALUE(save->trace, "clk_round_rate", clk_round_rate(clk, rate));
+	if (rounded < 0)
+		return rounded;
+	if (!sophgo_link_rate_matches(rounded, rate))
+		return -ERANGE;
+	ret = SOPHGO_TRACE_VALUE(save->trace, "clk_set_rate", clk_set_rate(clk, rounded));
+	if (ret)
+		return ret;
+	return sophgo_link_rate_matches(
+		   SOPHGO_TRACE_VALUE(save->trace, "clk_get_rate", clk_get_rate(clk)), rate)
+		   ? 0
+		   : -ERANGE;
+}
+
+static inline int sophgo_link_rate_restore(struct sophgo_link_rate *save)
+{
+	int ret;
+
+	if (!save->held)
+		return 0;
+	if (save->dirty) {
+		ret = SOPHGO_TRACE_VALUE(save->trace, "clk_set_parent",
+					 clk_set_parent(save->clk, save->parent));
+		if (ret)
+			return ret;
+		ret = SOPHGO_TRACE_VALUE(save->trace, "clk_set_rate",
+					 clk_set_rate(save->clk, save->rate));
+		if (ret)
+			return ret;
+		if (!clk_is_match(SOPHGO_TRACE_VALUE(save->trace, "clk_get_parent",
+						     clk_get_parent(save->clk)),
+				  save->parent) ||
+		    SOPHGO_TRACE_VALUE(save->trace, "clk_get_rate", clk_get_rate(save->clk)) !=
+			save->rate)
+			return -ERANGE;
+	}
+	SOPHGO_TRACE_VOID(save->trace, "clk_rate_exclusive_put", clk_rate_exclusive_put(save->clk));
+	save->held = save->dirty = false;
+	return 0;
+}
+
+static inline int sophgo_link_stop(struct sophgo_link *link)
+{
+	int ret;
+
+	if (link->video_owned) {
+		ret = SOPHGO_TRACE_VALUE(&link->trace, "link->video",
+					 link->video(link->video_ctx, false));
+		if (ret)
+			return ret;
+		link->video_owned = link->video_started = false;
+	}
+	if (link->phy_owned) {
+		SOPHGO_TRACE_VOID(&link->trace, "sophgo_dphy_power_down",
+				  sophgo_dphy_power_down(link->phy));
+		link->phy_owned = link->lp11_programmed = false;
+	}
+	/* Hardware is now quiescent. Keep references/protection on a failed
+	 * restore, so stop can be retried without restoring unowned state.
+	 */
+	ret = SOPHGO_TRACE_VALUE(&link->trace, "sophgo_link_rate_restore",
+				 sophgo_link_rate_restore(&link->escape));
+	if (ret)
+		return ret;
+	if (link->vip_div_owned) {
+		unsigned int value;
+		ret = SOPHGO_TRACE_VALUE(&link->trace, "regmap_update_bits",
+					 regmap_update_bits(link->vip->map, SOPHGO_VIP_CLK_CTRL0,
+							    1U << 4, link->vip_div_saved));
+		if (ret)
+			return ret;
+		ret = SOPHGO_TRACE_VALUE(&link->trace, "regmap_read",
+					 regmap_read(link->vip->map, SOPHGO_VIP_CLK_CTRL0, &value));
+		if (ret)
+			return ret;
+		if ((value & (1U << 4)) != link->vip_div_saved)
+			return -EIO;
+		link->vip_div_owned = false;
+	}
+	if (link->clocks_owned) {
+		sophgo_clocks_disable(link->clocks);
+		link->clocks_owned = false;
+	}
+	if (link->pll_held) {
+		SOPHGO_TRACE_VOID(&link->trace, "clk_rate_exclusive_put",
+				  clk_rate_exclusive_put(link->clocks->bulk[4].clk));
+		link->pll_held = false;
+	}
+	if (link->source_held) {
+		SOPHGO_TRACE_VOID(&link->trace, "clk_rate_exclusive_put",
+				  clk_rate_exclusive_put(link->clocks->bulk[6].clk));
+		link->source_held = false;
+	}
+	return 0;
+}
+
+/* Complete the fallible shared divider before lane/PLL access, retaining
+ * the vendor lane-map-before-PLL order inside the existing owner callback.
+ */
+static inline int sophgo_link_div(void *data, unsigned int value)
+{
+	struct sophgo_link *link = data;
+	int ret;
+	ret = SOPHGO_TRACE_VALUE(
+	    &link->trace, "regmap_read",
+	    regmap_read(link->vip->map, SOPHGO_VIP_CLK_CTRL0, &link->vip_div_saved));
+	if (ret)
+		return ret;
+	link->vip_div_saved &= 1U << 4;
+	link->vip_div_owned = true;
+	ret = SOPHGO_TRACE_VALUE(&link->trace, "sophgo_vip_div", sophgo_vip_div(link->vip, value));
+
+	if (ret)
+		return ret;
+	link->phy_owned = true;
+	SOPHGO_TRACE_VOID(&link->trace, "sophgo_dphy_set_lanes",
+			  sophgo_dphy_set_lanes(link->phy, &link->lanes));
+	return 0;
+}
+
+/* Golden 720p only; reuse the reviewed 1,2,0,3,4 / 445500 kbit/s /
+ * 6,32,5 primitives. esc_parent is a separately acquired CCF AXI6 handle.
+ * esc_hz and source_hz are explicit integration inputs, not boot defaults:
+ * osdrv never sets ESC; provider default divisor 5 is not a rate contract.
+ * osdrv aa542c41 dsi_phy.c:dphy_dsi_set_pll uses factor 900000 kHz;
+ * _cal_pll_reg supplies the pixel divider in TXPLL, and dphy_dsi_get_pixclk
+ * derives it there. vo_mipi_tx.c never retunes DISPPLL/clk_disp_src_vip.
+ * Require the matching 900 MHz DSI source; never change shared G2 bit 0.
+ * Preserve the shared PLL and display-divider settings. CCF references for
+ * the existing G2 owners remain; exclusive_get does not isolate consumers.
+ */
+static inline int sophgo_link_prepare(struct sophgo_link *link, struct clk *esc_parent,
+				      unsigned long esc_hz, unsigned long source_hz)
+{
+	const unsigned int roles[] = {1, 2, 0, 3, 4};
+	struct sophgo_dphy_pll pll;
+	unsigned int hs, resets;
+	int ret, unwind;
+
+	if (!link || !link->clocks || !link->vip || !link->vip->map ||
+	    link->vip->clocks != link->clocks || !link->phy || !link->top || !esc_parent ||
+	    !link->video)
+		return -ENODEV;
+	if (!esc_hz || esc_hz > 20000000 || source_hz != 900000000)
+		return -EINVAL;
+	if (link->lp11_programmed) {
+		if (link->esc_hz != esc_hz || link->source_hz != source_hz ||
+		    !clk_is_match(link->esc_parent, esc_parent))
+			return -EBUSY;
+		return sophgo_link_ready(link); /* never unwind an existing user */
+	}
+	if (link->clocks->enabled || link->pll_held)
+		return -EBUSY; /* another owner, or stop still needs to finish */
+	if (sophgo_dphy_calc_pll(74250, 4, 24, 25000, &pll) ||
+	    sophgo_dphy_calc_lanes(roles, 0, 1, pll.preamble, &link->lanes) ||
+	    sophgo_dphy_calc_hs(6, 32, 5, &hs))
+		return -EINVAL;
+	link->clocks->trace = &link->trace;
+	link->escape.trace = &link->trace;
+	link->esc_hz = esc_hz;
+	link->source_hz = source_hz;
+	link->esc_parent = esc_parent;
+	ret = SOPHGO_TRACE_VALUE(&link->trace, "clk_rate_exclusive_get",
+				 clk_rate_exclusive_get(link->clocks->bulk[4].clk));
+	if (ret)
+		return ret;
+	link->pll_held = true;
+	/* Protect the separate source ancestry even when DISPPLL bypasses it. */
+	ret = SOPHGO_TRACE_VALUE(&link->trace, "clk_rate_exclusive_get",
+				 clk_rate_exclusive_get(link->clocks->bulk[6].clk));
+	if (ret)
+		goto fail;
+	link->source_held = true;
+	ret = sophgo_clocks_enable(link->clocks);
+	if (ret)
+		goto fail;
+	link->clocks_owned = true;
+	link->pll_hz = SOPHGO_TRACE_VALUE(&link->trace, "clk_get_rate",
+					clk_get_rate(link->clocks->bulk[4].clk));
+	if (!link->pll_hz ||
+	    SOPHGO_TRACE_VALUE(&link->trace, "clk_get_rate",
+			       clk_get_rate(link->clocks->bulk[6].clk)) != source_hz) {
+		ret = -ERANGE;
+		goto fail;
+	}
+	/* Neither vo_mipi_tx:_init_resources nor set_combo_dev_cfg pulses
+	 * local resets. Required pulse mask is zero. Reject asserted firmware
+	 * resets instead of clearing/restoring resets we never acquired.
+	 * Shared regmap serializes this access and the divider callback.
+	 */
+	ret = SOPHGO_TRACE_VALUE(&link->trace, "regmap_read",
+				 regmap_read(link->vip->map, SOPHGO_VIP_RESET, &resets));
+	if (ret)
+		goto fail;
+	if (resets & SOPHGO_VIP_DISPLAY_RESETS) {
+		ret = -EBUSY;
+		goto fail;
+	}
+	/* Quiesce a firmware-preselected MAC before changing its PHY. An idle
+	 * timeout retains clocks for explicit stop; no dependent PHY access.
+	 */
+	link->video_owned = true;
+	ret = SOPHGO_TRACE_VALUE(&link->trace, "link->video", link->video(link->video_ctx, false));
+	if (ret)
+		return ret;
+	link->video_owned = link->video_started = false;
+	ret = SOPHGO_TRACE_VALUE(
+	    &link->trace, "sophgo_link_rate_set",
+	    sophgo_link_rate_set(&link->escape, link->clocks->bulk[3].clk, esc_parent, esc_hz));
+	if (ret)
+		goto fail;
+	ret = sophgo_link_ready(link);
+	if (ret)
+		goto fail;
+	/* Divider is fallible: complete it before ANY PHY MMIO. The existing
+	 * PLL helper itself calls the owner before its dependent PLL writes.
+	 */
+	ret = SOPHGO_TRACE_VALUE(&link->trace, "sophgo_dphy_set_pll",
+				 sophgo_dphy_set_pll(link->phy, &pll, sophgo_link_div, link));
+	if (ret)
+		goto fail;
+	SOPHGO_TRACE_VOID(&link->trace, "sophgo_dphy_set_hs", sophgo_dphy_set_hs(link->phy, hs));
+	SOPHGO_TRACE_VOID(&link->trace, "sophgo_dphy_lp11", sophgo_dphy_lp11(link->phy));
+	SOPHGO_TRACE_VOID(&link->trace, "sophgo_disp_mux_dsi", sophgo_disp_mux_dsi(link->top));
+	link->lp11_programmed = true;
+	return 0;
+fail:
+	unwind = sophgo_link_stop(link);
+	return unwind ? unwind : ret;
+}
+
+static inline int sophgo_link_video(struct sophgo_link *link)
+{
+	int ret;
+
+	if (!link->lp11_programmed || !link->video)
+		return -EACCES;
+	ret = sophgo_link_ready(link);
+	if (ret)
+		return ret;
+	if (link->video_owned)
+		return link->video_started ? 0 : -EBUSY;
+	/* start may fail after partial MAC writes; stop must still idle it. */
+	link->video_owned = true;
+	ret = SOPHGO_TRACE_VALUE(&link->trace, "link->video", link->video(link->video_ctx, true));
+	if (!ret)
+		link->video_started = true;
+	return ret;
+}
+#endif
diff --git a/interdrv/sophgo-dsi/sophgo-mac.h b/interdrv/sophgo-dsi/sophgo-mac.h
new file mode 100644
--- /dev/null
+++ b/interdrv/sophgo-dsi/sophgo-mac.h
@@ -0,0 +1,298 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SOPHGO_MAC_H
+#define SOPHGO_MAC_H
+
+#include <linux/iopoll.h>
+#include <linux/delay.h>
+#include <linux/ktime.h>
+
+/*
+ * Provenance (not a claim of golden-binary/source equivalence):
+ * sophgo/osdrv aa542c41df94f7bc656cb740f6622a5dca7dc403, interdrv/:
+ * vo/chip/cv181x/vo_mipi_tx.c:mipi_tx_check_comb_dev_cfg (burst only),
+ * mipi_tx_set_combo_dev_cfg (RGB888, config then display timing),
+ * _fill_disp_timing (sync/blanking counters), mipi_tx_enable/disable;
+ * vpss/chip/cv181x/scaler.c:sclr_dsi_config (lane encoding, WC, delay),
+ * sclr_dsi_set_mode/clr_mode/chk_mode_done (MAC_EN transaction);
+ * scaler.h: SCLR_DSI_MODE_HS=4, SCLR_DSI_FMT_RGB888=0;
+ * scaler_reg.h: REG_SCL_DSI_MAC_EN/HS_0/HS_1 offsets;
+ * vpss/common/vpss_common.h:UPPER(x,3) = ceil(x/8).
+ *
+ * Field widths and meanings: SG2000 TRM v1.0, sophgo/sophgo-doc
+ * 370d81b365ed528dc8f5dc91f63ed445e1142d4d, SG200X/TRM/contents/
+ * cn/video/mipi_tx_control_registers_description.table.rst:
+ * REG_00 bits 2:0 RWS mode triggers, bits 5:4 read-only done;
+ * REG_01 lanes 25:24, EoT 26, continuous clock 29, RGB format 31:30;
+ * REG_02 WC 15:0 bytes, event delay 26:16 in pixel clocks.
+ * en/video/mipi_tx.rst: burst emits sync events and active data, otherwise
+ * BLLP (its media/image82.png shows VSS/HSS, not VSE/HSE packets).
+ * No programmable HSA/HBP/HFP packet counts or non-burst selector is
+ * supplied by this call path/table. Reuse DISP timing, never reinterpret
+ * HS_0's software-short-packet bits 23:0 as a video header/blanking WC.
+ * Hardware supplies RGB888 DI 0x3e, ECC/CRC and sync packets; WC excludes
+ * protocol overhead. No guessed padding packets or sync-pulse mode.
+ */
+#define SOPHGO_MAC_EN 0x00
+#define SOPHGO_MAC_HS0 0x04
+#define SOPHGO_MAC_HS1 0x08
+#define SOPHGO_MAC_SIZE 0x0c
+#define SOPHGO_MAC_VIDEO 0x4
+#define SOPHGO_MAC_HS0_MASK 0xe7000000U
+#define SOPHGO_MAC_HS1_MASK 0x07ffffffU
+#define SOPHGO_MAC_BRIDGE_FLAGS                                                                    \
+	(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_VIDEO_NO_HFP |                    \
+	 MIPI_DSI_MODE_NO_EOT_PACKET)
+
+struct sophgo_mac_mode {
+	unsigned int pixel_khz;
+	unsigned int hdisplay, hsync_start, hsync_end, htotal;
+	unsigned int vdisplay, vsync_start, vsync_end, vtotal;
+	unsigned int lanes, format, channel;
+	unsigned long flags;
+};
+
+struct sophgo_mac_config {
+	unsigned int hs0, hs1;
+	struct sophgo_disp_axis h, v;
+};
+
+struct sophgo_mac {
+	void __iomem *base;
+	bool configured;
+	/* emit an end-of-transmission packet. Default true to match the
+	 * golden Debian transmitter (HS_0=0x26000000); the module parameter
+	 * mac_no_eot can clear it to reproduce the no-EoT register (0x22000000).
+	 */
+	bool eot;
+	/* Snapshot of this start attempt, retained across unwind. */
+	unsigned int start_initial, start_final;
+	s64 start_poll_us;
+	/* vendor sclr_dsi_set_mode(HS) (vo_mipi_tx.c:mipi_tx_enable)
+	 * writes the HS request and returns without polling. When set, a MAC HS
+	 * poll timeout is non-fatal: sophgo_mac_start keeps the MAC configured and
+	 * returns 0 so the pipeline enables the downstream, matching that model.
+	 * Set from the mac_fire_and_forget module parameter (default on).
+	 */
+	bool fire_and_forget;
+	/* tight post-write burst sample of the RWS video bit, to catch
+	 * a sub-poll flicker (HS momentarily engages then drops) vs never asserting. */
+	unsigned int start_burst_max, start_burst_hits, start_burst_reads;
+};
+
+static inline int sophgo_mac_validate_link(unsigned int lanes, unsigned int format,
+					   unsigned int channel, unsigned long flags)
+{
+	const unsigned long required = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST;
+	const unsigned long allowed =
+	    required | MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_VIDEO_NO_HFP | MIPI_DSI_MODE_NO_EOT_PACKET;
+
+	if ((lanes != 1 && lanes != 2 && lanes != 4) || format != MIPI_DSI_FMT_RGB888 || channel)
+		return -EINVAL;
+	if ((flags & required) != required || (flags & ~allowed))
+		return -EOPNOTSUPP;
+	return 0;
+}
+
+/*
+ * Linux 7.2.2 drivers/gpu/drm/bridge/lontium-lt8912b.c:lt8912_attach_dsi
+ * registers type "lt8912" with info.node=NULL (do not match dev.of_node),
+ * requests VIDEO|LPM|NO_HFP|NO_EOT, RGB888. For that exact four-lane VC0
+ * bridge request only, negotiate BURST explicitly, retaining NO_EOT.
+ * Its I2C-only initialization needs no DSI transfers. Other non-burst
+ * requests fail; do not silently reinterpret arbitrary peripherals.
+ * Caller publishes the returned flags only after successful host attach.
+ * Golden vendor reset defaults include EoT: HS0=0x26000000. Honoring the
+ * bridge's NO_EOT gives 0x22000000 instead; this is deliberate source-level
+ * negotiation, not measured equivalence. Continuous clock remains enabled.
+ * LPM concerns command transfers (still unsupported), not LP video.
+ */
+static inline int sophgo_mac_negotiate(bool lt8912b, unsigned int lanes, unsigned int format,
+				       unsigned int channel, unsigned long flags,
+				       unsigned long *negotiated)
+{
+	int ret;
+
+	if (!negotiated)
+		return -EINVAL;
+	if (lt8912b && lanes == 4 && flags == SOPHGO_MAC_BRIDGE_FLAGS)
+		flags |= MIPI_DSI_MODE_VIDEO_BURST;
+	ret = sophgo_mac_validate_link(lanes, format, channel, flags);
+	if (!ret)
+		*negotiated = flags;
+	return ret;
+}
+
+/* Bounds before multiply/shift; output untouched on failure. Exposed separately
+ * so native tests exercise the actual 16-bit WC and 11-bit delay boundaries,
+ * including inputs larger than the DISP block's 14-bit timing range.
+ */
+static inline int sophgo_mac_packet(unsigned int width, unsigned int *word)
+{
+	if (!word || !width || width > 65535 / 3 || width / 10 > 2047)
+		return -ERANGE;
+	*word = ((width / 10) << 16) | (width * 3);
+	return 0;
+}
+
+/* Pure preflight. Pixel rate/PLL qualification belongs to clock/PHY helpers;
+ * no MAC timebase is fabricated from kHz. DISP counters encode all porches.
+ * Golden 74250 kHz: h=40/220/1280/110, v=5/20/720/5, WC=3840,
+ * event delay=128 pixel clocks, HS1=0x00800f00.
+ */
+static inline int sophgo_mac_calc(const struct sophgo_mac_mode *mode, struct sophgo_mac_config *out)
+{
+	struct sophgo_mac_config cfg;
+	int ret;
+
+	if (!mode || !out || !mode->pixel_khz)
+		return -EINVAL;
+	ret = sophgo_mac_validate_link(mode->lanes, mode->format, mode->channel, mode->flags);
+	if (ret)
+		return ret;
+	ret = sophgo_mac_packet(mode->hdisplay, &cfg.hs1);
+	if (ret)
+		return ret;
+	if (sophgo_disp_calc_axis(mode->hdisplay, mode->hsync_start, mode->hsync_end, mode->htotal,
+				  &cfg.h) ||
+	    sophgo_disp_calc_axis(mode->vdisplay, mode->vsync_start, mode->vsync_end, mode->vtotal,
+				  &cfg.v))
+		return -EINVAL;
+	/* Continuous clock (bit 29) and EoT (bit 26) are hardware reset defaults
+	 * the vendor sclr_dsi_config() never rewrites (its mask is 0xc3000000).
+	 * The golden Debian transmitter therefore runs with both set:
+	 * HS_0=0x26000000.
+	 * The LT8912B bridge advertises MIPI_DSI_MODE_NO_EOT_PACKET, but the
+	 * working silicon keeps EoT on, so this pure value always includes it;
+	 * a supervised override lives in sophgo_mac_configure().
+	 */
+	cfg.hs0 = ((mode->lanes >> 1) << 24) | (1U << 29) | (1U << 26);
+	*out = cfg;
+	return 0;
+}
+
+/* Bind only a checked named dsi_mac mapping; no access and no clock enable. */
+static inline int sophgo_mac_init(struct sophgo_mac *mac, void __iomem *base,
+				  unsigned long long size)
+{
+	if (!mac || !base || size < SOPHGO_MAC_SIZE)
+		return -EINVAL;
+	mac->base = base;
+	mac->configured = false;
+	mac->eot = true;
+	mac->fire_and_forget = false;
+	return 0;
+}
+
+/*
+ * Callable lifecycle for composition (all sleepable and caller-serialized):
+ * init -> calc/preflight -> clocks/PHY preparation -> configure (DISP tgen
+ * stopped) -> DISP timing/pattern/TGEN under LP-11 -> bridge preparation -> start.
+ * Stop MAC while clocks/timing are still available, then stop DISP/PHY and
+ * release clocks. configure leaves MAC idle; start never starts the tgen.
+ * A timeout is not quiescence: keep clocks/resources until owner recovery.
+ * Never race these leaves with host commands, reset, IRQ or another commit.
+ * No leaf is called by the guarded DRM callbacks in this source-only slice.
+ *
+ * MAC_EN is RWS, not ordinary R/W: vendor clr_mode writes the observed
+ * active mode back, NOT zero. Preserve reserved bits and read-only status,
+ * never replay another command trigger. Refuse foreign command modes.
+ * Bound completion to 20ms (vendor disable polls roughly 20 x 1..2ms).
+ */
+static inline int sophgo_mac_quiesce(struct sophgo_mac *mac)
+{
+	unsigned int val;
+	int ret;
+
+	if (!mac || !mac->base)
+		return -EINVAL;
+	val = readl(mac->base + SOPHGO_MAC_EN);
+	if ((val & 0xf) && (val & 0xf) != SOPHGO_MAC_VIDEO)
+		return -EBUSY;
+	if (val & SOPHGO_MAC_VIDEO)
+		writel(val, mac->base + SOPHGO_MAC_EN);
+	ret = read_poll_timeout(readl, val, !(val & 0xf), 1000, 20000, false,
+				mac->base + SOPHGO_MAC_EN);
+	if (ret)
+		mac->configured = false;
+	return ret;
+}
+
+static inline int sophgo_mac_configure(struct sophgo_mac *mac, const struct sophgo_mac_mode *mode)
+{
+	struct sophgo_mac_config cfg;
+	unsigned int val;
+	int ret;
+
+	if (!mac || !mac->base)
+		return -EINVAL;
+	ret = sophgo_mac_calc(mode, &cfg);
+	if (ret)
+		return ret; /* invalid input must not even read MMIO */
+	/* Supervised experiment only: mac_no_eot=1 reproduces the no-EoT HS_0 that
+	 * dropped EoT, for an A/B on the same silicon against the golden 0x26.
+	 */
+	if (!mac->eot)
+		cfg.hs0 &= ~(1U << 26);
+	mac->configured = false;
+	ret = sophgo_mac_quiesce(mac);
+	if (ret)
+		return ret;
+	val = readl(mac->base + SOPHGO_MAC_HS0);
+	writel((val & ~SOPHGO_MAC_HS0_MASK) | cfg.hs0, mac->base + SOPHGO_MAC_HS0);
+	val = readl(mac->base + SOPHGO_MAC_HS1);
+	writel((val & ~SOPHGO_MAC_HS1_MASK) | cfg.hs1, mac->base + SOPHGO_MAC_HS1);
+	/* Flush posted configuration before allowing start. */
+	readl(mac->base + SOPHGO_MAC_HS1);
+	mac->configured = true;
+	return 0;
+}
+
+static inline int sophgo_mac_start(struct sophgo_mac *mac)
+{
+	unsigned int val;
+	int ret;
+	ktime_t begin;
+
+	if (!mac || !mac->base || !mac->configured)
+		return -EINVAL;
+	mac->start_poll_us = 0;
+	mac->start_burst_max = mac->start_burst_hits = mac->start_burst_reads = 0;
+	val = readl(mac->base + SOPHGO_MAC_EN);
+	mac->start_initial = mac->start_final = val;
+	if (val & 0xf)
+		return -EBUSY; /* never toggle an already-running RWS video bit */
+	/* let the display TGEN/pattern FIFO and D-PHY settle before the
+	 * HS enable. This delay was an experiment retained in the demonstrated
+	 * sequence; its necessity has not been isolated. */
+	usleep_range(5000, 7000);
+	writel(val | SOPHGO_MAC_VIDEO, mac->base + SOPHGO_MAC_EN);
+	/* burst-sample MAC_EN immediately, tighter than the 1ms poll, to
+	 * distinguish a transient HS latch that drops from HS never asserting.
+	 * The samples alone do not identify the physical cause. */
+	mac->start_burst_reads = 256;
+	{
+		unsigned int i, s;
+
+		for (i = 0; i < mac->start_burst_reads; i++) {
+			s = readl(mac->base + SOPHGO_MAC_EN) & 0xf;
+			if (s > mac->start_burst_max)
+				mac->start_burst_max = s;
+			if (s == SOPHGO_MAC_VIDEO)
+				mac->start_burst_hits++;
+		}
+	}
+	begin = ktime_get();
+	ret = read_poll_timeout(readl, val, (val & 0xf) == SOPHGO_MAC_VIDEO, 1000, 20000, false,
+				mac->base + SOPHGO_MAC_EN);
+	mac->start_poll_us = ktime_us_delta(ktime_get(), begin);
+	mac->start_final = val;
+	if (ret && mac->fire_and_forget)
+		/* Vendor sclr_dsi_set_mode(HS) is fire-and-forget: the HS request is
+		 * written and enable proceeds; the MAC acknowledges HS once the full
+		 * stream (TGEN + downstream) runs. Keep configured for the later stop. */
+		return 0;
+	if (ret)
+		mac->configured = false;
+	return ret;
+}
+#endif
diff --git a/interdrv/sophgo-dsi/sophgo-pipeline.h b/interdrv/sophgo-dsi/sophgo-pipeline.h
new file mode 100644
--- /dev/null
+++ b/interdrv/sophgo-dsi/sophgo-pipeline.h
@@ -0,0 +1,227 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SOPHGO_PIPELINE_H
+#define SOPHGO_PIPELINE_H
+/* Same entry points are called by the host bridge and the native harness.
+ * The caller serializes the whole chain against commits/detach/shutdown.
+ * DRM 7.2.2 default tail calls CRTC enable BEFORE bridge pre_enable: CRTC
+ * enable must therefore remain inert. Host preparation starts TGEN under
+ * LP-11 before bridge preparation; host enable starts MAC, then downstream DDS. Reverse: bridge
+ * reset, MAC acknowledged stop, posted display stop, bridge rails, PHY/CCF release.
+ */
+struct sophgo_pipeline {
+	struct sophgo_link link;
+	struct sophgo_mac *mac;
+	void __iomem *disp;
+	struct sophgo_mac_mode mode;
+	struct sophgo_disp_timing timing;
+	struct lt8912b_pipeline status;
+	bool display_owned;
+	/* Failure sink runs before unwind, while register clocks remain held. */
+	void (*start_failure)(struct sophgo_pipeline *p, unsigned int disp_cfg, int error);
+	/* Optional register-page snapshot; only called while clocks are owned. */
+	void (*snapshot)(struct sophgo_pipeline *p, const char *label);
+};
+
+static inline int sophgo_pipeline_validate(const struct sophgo_mac_mode *m,
+					   const struct sophgo_dphy_lanes *lanes,
+					   unsigned int polarity, bool event, bool framebuffer,
+					   bool allowed)
+{
+	const unsigned int roles[] = {1, 2, 0, 3, 4};
+	struct sophgo_dphy_lanes golden;
+	struct sophgo_mac_config cfg;
+	if (event || framebuffer || !allowed)
+		return -EOPNOTSUPP;
+	if (!m || !lanes || m->pixel_khz != 74250 || m->hdisplay != 1280 ||
+	    m->hsync_start != 1390 || m->hsync_end != 1430 || m->htotal != 1650 ||
+	    m->vdisplay != 720 || m->vsync_start != 725 || m->vsync_end != 730 ||
+	    m->vtotal != 750 || m->lanes != 4 || polarity != 0x60 ||
+	    m->flags != (SOPHGO_MAC_BRIDGE_FLAGS | MIPI_DSI_MODE_VIDEO_BURST))
+		return -EINVAL;
+	if (sophgo_dphy_calc_lanes(roles, 0, 1, 0, &golden) ||
+	    memcmp(lanes, &golden, sizeof(golden)))
+		return -EINVAL;
+	return sophgo_mac_calc(m, &cfg);
+}
+
+static inline int sophgo_pipeline_video(void *ctx, bool enable)
+{
+	struct sophgo_pipeline *p = ctx;
+	int ret;
+	if (enable) {
+		bool acked;
+		ret = SOPHGO_TRACE_VALUE(&p->link.trace, "sophgo_mac_start",
+					 sophgo_mac_start(p->mac));
+		/* with mac_fire_and_forget, a HS poll timeout returns 0 so
+		 * the pipeline enables the downstream, yet the MAC may not have acked HS.
+		 * Label the snapshot and log the failure line from the observed MAC_EN,
+		 * not from ret, so the -110 evidence survives the non-fatal path. */
+		acked = (p->mac->start_final & 0xf) == SOPHGO_MAC_VIDEO;
+		if (!acked && p->start_failure)
+			p->start_failure(p, readl(p->disp + SOPHGO_DISP_CFG), ret ? ret : -ETIMEDOUT);
+		if (p->snapshot)
+			p->snapshot(p, acked ? "started" : "start-failed");
+		return ret;
+	}
+	/* Keep timing available for the MAC acknowledgement. On timeout retain
+	 * all sources; no fake physical-stop assertion and no forced reset.
+	 */
+	ret = SOPHGO_TRACE_VALUE(&p->link.trace, "sophgo_mac_quiesce", sophgo_mac_quiesce(p->mac));
+	if (ret)
+		return ret;
+	SOPHGO_TRACE_VOID(&p->link.trace, "sophgo_disp_disable", sophgo_disp_disable(p->disp));
+	p->display_owned = false;
+	return 0;
+}
+
+static inline int sophgo_pipeline_prepare(struct sophgo_pipeline *p,
+					  const struct sophgo_mac_mode *m,
+					  const struct sophgo_dphy_lanes *lanes,
+					  unsigned int polarity, bool event, bool framebuffer,
+					  bool allowed, struct clk *esc_parent,
+					  unsigned long esc_hz, unsigned long source_hz)
+{
+	int ret = sophgo_pipeline_validate(m, lanes, polarity, event, framebuffer, allowed);
+	if (ret)
+		return ret;
+	if (!p || !p->mac || !p->mac->base || !p->disp || !p->link.top)
+		return -ENODEV;
+	if (p->status.error || p->status.host_prepared)
+		return -EBUSY;
+	p->mode = *m;
+	p->timing.polarity = polarity;
+	sophgo_disp_calc_axis(m->hdisplay, m->hsync_start, m->hsync_end, m->htotal, &p->timing.h);
+	sophgo_disp_calc_axis(m->vdisplay, m->vsync_start, m->vsync_end, m->vtotal, &p->timing.v);
+	p->link.video = sophgo_pipeline_video;
+	p->link.video_ctx = p;
+	ret = SOPHGO_TRACE_VALUE(&p->link.trace, "sophgo_link_prepare",
+				 sophgo_link_prepare(&p->link, esc_parent, esc_hz, source_hz));
+	lt8912b_pipeline_error(&p->status, "host clocks/PHY prepare", ret);
+	if (ret)
+		return ret;
+	ret = SOPHGO_TRACE_VALUE(&p->link.trace, "sophgo_mac_configure",
+				 sophgo_mac_configure(p->mac, m));
+	lt8912b_pipeline_error(&p->status, "MAC configure", ret);
+	if (ret)
+		return ret;
+	/* Vendor display-subsystem init (scaler.c:sclr_ctrl_init), in the vendor
+	 * order and before the DISP
+	 * timing/pattern/TGEN writes: scaler-top config with its reg_done and
+	 * force_up, then the DISP format/source/cache fields under the shadow
+	 * mask, reading the working bank. The prepared snapshot records readback;
+	 * it does not establish what the MAC requires before entering HS.
+	 */
+	SOPHGO_TRACE_VOID(&p->link.trace, "sophgo_sc_top_init", sophgo_sc_top_init(p->link.top));
+	SOPHGO_TRACE_VOID(&p->link.trace, "sophgo_disp_shadow_begin",
+			  sophgo_disp_shadow_begin(p->disp));
+	SOPHGO_TRACE_VOID(&p->link.trace, "sophgo_disp_init", sophgo_disp_init(p->disp));
+	SOPHGO_TRACE_VOID(&p->link.trace, "sophgo_disp_set_timing",
+			  sophgo_disp_set_timing(p->disp, &p->timing));
+	SOPHGO_TRACE_VOID(&p->link.trace, "sophgo_disp_pattern", sophgo_disp_pattern(p->disp, 1));
+	/* osdrv aa542c41 vo_mipi_tx.c:mipi_tx_set_combo_dev_cfg enables TGEN
+	 * after timing, before external reset and mipi_tx_enable (HS). Keep
+	 * the LP-11 override through downstream preparation. This corrects
+	 * source ordering; it does not establish a cause for an HS timeout.
+	 */
+	SOPHGO_TRACE_VOID(&p->link.trace, "sophgo_disp_tgen", sophgo_disp_tgen(p->disp, 1));
+	SOPHGO_TRACE_VOID(&p->link.trace, "sophgo_disp_shadow_commit",
+			  sophgo_disp_shadow_commit(p->disp));
+	p->display_owned = true;
+	p->status.host_prepared = true;
+	/* TGEN running, MAC idle, pads at LP-11: the state handed to the bridge. */
+	if (p->snapshot)
+		p->snapshot(p, "prepared");
+	return 0;
+}
+
+static inline int sophgo_pipeline_enable(struct sophgo_pipeline *p)
+{
+	int ret;
+	if (p->status.error)
+		return p->status.error;
+	if (!p->status.prepared || !p->status.host_prepared)
+		return -EACCES;
+	if (p->status.host_started)
+		return 0;
+	ret = SOPHGO_TRACE_VALUE(&p->link.trace, "sophgo_link_video", sophgo_link_video(&p->link));
+	lt8912b_pipeline_error(&p->status, "MAC start", ret);
+	if (ret)
+		return ret;
+	p->status.host_started = true;
+	return 0;
+}
+
+static inline int sophgo_pipeline_disable(struct sophgo_pipeline *p)
+{
+	int ret = 0;
+	if (p->link.clocks_owned) {
+		/* A failed configure can leave an unacknowledged MAC even before
+		 * video start acquired ownership. Post-disable must retry that stop.
+		 */
+		p->link.video_owned = true;
+		ret = sophgo_pipeline_video(p, false);
+	}
+	lt8912b_pipeline_error(&p->status, "MAC/display stop", ret);
+	if (!ret) {
+		p->link.video_owned = p->link.video_started = false;
+		p->status.host_started = false;
+	}
+	return ret;
+}
+
+static inline int sophgo_pipeline_unprepare(struct sophgo_pipeline *p)
+{
+	int ret;
+	if (p->status.supplies_owned)
+		return -EBUSY;
+	ret = SOPHGO_TRACE_VALUE(&p->link.trace, "sophgo_link_stop", sophgo_link_stop(&p->link));
+	lt8912b_pipeline_error(&p->status, "PHY/clock release", ret);
+	if (!ret)
+		p->status.host_prepared = false;
+	return ret;
+}
+/* A void DRM callback is never an end-to-end success signal. Source callers
+ * get the first stage/errno and an ordered partial unwind. The DRM wrapper
+ * logs this result, while atomic_check continues rejecting ALL active commits.
+ */
+static inline int sophgo_pipeline_complete(struct sophgo_pipeline *p, struct drm_bridge *bridge)
+{
+	if (!p->status.error)
+		return 0;
+	SOPHGO_TRACE_VOID(&p->link.trace, "drm_atomic_bridge_chain_disable",
+			  drm_atomic_bridge_chain_disable(bridge, NULL));
+	SOPHGO_TRACE_VOID(&p->link.trace, "drm_atomic_bridge_chain_post_disable",
+			  drm_atomic_bridge_chain_post_disable(bridge, NULL));
+	return p->status.error;
+}
+
+/* Includes partially restored clocks: terminal devres must never discard them. */
+static inline bool sophgo_pipeline_owned(struct sophgo_pipeline *p)
+{
+	return p->status.supplies_owned || p->display_owned || p->status.host_started ||
+	       p->link.clocks_owned || p->link.pll_held || p->link.source_held ||
+	       p->link.video_owned || p->link.phy_owned ||
+	       p->link.escape.held;
+}
+
+/* Retry is explicit, and only legal after every owner has released. */
+static inline int sophgo_pipeline_retry(struct sophgo_pipeline *p)
+{
+	if (sophgo_pipeline_owned(p))
+		return -EBUSY;
+	memset(&p->status, 0, sizeof(p->status));
+	return 0;
+}
+/* Manual-only API. No atomic state is swapped, no event/vblank is promised.
+ * Every callback is the production bridge chain, with its shared error result.
+ */
+static inline int sophgo_pipeline_manual_stop(struct sophgo_pipeline *p,
+					      struct drm_bridge *bridge)
+{
+	SOPHGO_TRACE_VOID(&p->link.trace, "drm_atomic_bridge_chain_disable",
+			  drm_atomic_bridge_chain_disable(bridge, NULL));
+	SOPHGO_TRACE_VOID(&p->link.trace, "drm_atomic_bridge_chain_post_disable",
+			  drm_atomic_bridge_chain_post_disable(bridge, NULL));
+	return sophgo_pipeline_owned(p) ? (p->status.error ?: -EBUSY) : 0;
+}
+#endif
diff --git a/interdrv/sophgo-dsi/sophgo-trace.h b/interdrv/sophgo-dsi/sophgo-trace.h
new file mode 100644
--- /dev/null
+++ b/interdrv/sophgo-dsi/sophgo-trace.h
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SOPHGO_TRACE_H
+#define SOPHGO_TRACE_H
+
+/* One serialized writer. Labels are string literals with module lifetime.
+ * The optional sink publishes lock-free breadcrumbs and console messages.
+ * "returned" means the call returned, including errors, NOT hardware success.
+ * No tracing inside polling iterations or provider spinlocks. A deadline
+ * cannot bound an MMIO transaction that never returns.
+ */
+struct sophgo_trace {
+	void (*emit)(void *ctx, const char *label, bool returned);
+	void *ctx;
+	const char *entered, *returned;
+};
+
+static inline void sophgo_trace_mark(struct sophgo_trace *trace, const char *label, bool returned)
+{
+	if (trace && trace->emit)
+		trace->emit(trace->ctx, label, returned);
+}
+
+/* Evaluate every operation exactly once, preserving its type and result. */
+#define SOPHGO_TRACE_VALUE(trace, label, call)                                                     \
+	({                                                                                         \
+		struct sophgo_trace *__trace = (trace);                                            \
+		sophgo_trace_mark(__trace, label, false);                                          \
+		__auto_type __value = (call);                                                      \
+		sophgo_trace_mark(__trace, label, true);                                           \
+		__value;                                                                           \
+	})
+#define SOPHGO_TRACE_VOID(trace, label, call)                                                      \
+	do {                                                                                       \
+		struct sophgo_trace *__trace = (trace);                                            \
+		sophgo_trace_mark(__trace, label, false);                                          \
+		call;                                                                              \
+		sophgo_trace_mark(__trace, label, true);                                           \
+	} while (0)
+#endif
diff --git a/interdrv/sophgo-dsi/sophgo-vip.h b/interdrv/sophgo-dsi/sophgo-vip.h
new file mode 100644
--- /dev/null
+++ b/interdrv/sophgo-dsi/sophgo-vip.h
@@ -0,0 +1,109 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SOPHGO_VIP_H
+#define SOPHGO_VIP_H
+
+/* osdrv aa542c41, interdrv/base/chip/cv181x/{reg_vip_sys.h,vip_common.h}:
+ * VIP +0 is active-high LOCAL reset, +0x18 is shared with capture clocks.
+ * The DT syscon owns the window and its regmap lock serializes masked RMWs
+ * across all consumers. Never use regmap_write or a private MMIO alias here.
+ * Display owns only these five reset bits; capture must use disjoint masks.
+ * sc_top (4), sc_top_apb (18), clk_div (15), and TOP RST_VIPSYS are shared
+ * and deliberately excluded. vo_mipi_tx.c:_init_resources enables display
+ * then DSI but does not pulse these local resets. Thus the bit definitions
+ * are source facts, NOT evidence that pulsing all five is required at init.
+ * Integration chooses reset/PHY sequencing while quiescent, under DRM locks.
+ */
+#define SOPHGO_VIP_RESET 0x00
+#define SOPHGO_VIP_CLK_CTRL0 0x18
+#define SOPHGO_VIP_DISP_RESET (1U << 9)
+#define SOPHGO_VIP_MAC_RESET (1U << 11)
+#define SOPHGO_VIP_MAC_APB_RESET (1U << 20)
+#define SOPHGO_VIP_PHY_APB_RESET (1U << 23)
+#define SOPHGO_VIP_PHY_RESET (1U << 26)
+#define SOPHGO_VIP_DISPLAY_RESETS 0x04900a00U
+
+struct sophgo_vip {
+	struct regmap *map;
+	struct sophgo_clocks *clocks;
+};
+
+/* DT contract for later integration: sophgo,vip-sys phandle to a dedicated
+ * compatible = "sophgo,sg2000-vip-sys", "syscon" node, reg >= 0x1c.
+ * No board node is activated here. syscon owns one shared, uncached regmap
+ * for that node for its lifetime. Reject TOP/clock syscons and short ranges.
+ */
+static inline int sophgo_vip_get(struct device *dev, struct sophgo_vip *vip,
+				 struct sophgo_clocks *clocks)
+{
+	struct device_node *np;
+	struct resource res;
+	struct regmap *map;
+	int ret;
+
+	np = of_parse_phandle(dev->of_node, "sophgo,vip-sys", 0);
+	if (!np)
+		return -ENODEV;
+	if (!of_device_is_compatible(np, "sophgo,sg2000-vip-sys") ||
+	    !of_device_is_compatible(np, "syscon")) {
+		of_node_put(np);
+		return -EINVAL;
+	}
+	ret = of_address_to_resource(np, 0, &res);
+	if (!ret && resource_size(&res) < 0x1c)
+		ret = -EINVAL;
+	map = ret ? ERR_PTR(ret) : syscon_node_to_regmap(np);
+	of_node_put(np);
+	if (IS_ERR(map))
+		return PTR_ERR(map);
+	vip->map = map;
+	vip->clocks = clocks;
+	return 0;
+}
+
+static inline int sophgo_vip_ready(struct sophgo_vip *vip)
+{
+	if (!vip || !vip->map || !vip->clocks)
+		return -ENODEV;
+	return vip->clocks->enabled ? 0 : -EACCES;
+}
+
+/* Production callback for sophgo_dphy_set_pll: fail before PHY MMIO.
+ * dsi_phy.c:_cal_pll_reg changes ONLY disp_sel_bt_div1 (bit 4).
+ * Readback drains the divider write before the dependent PHY access.
+ */
+static inline int sophgo_vip_div(void *data, unsigned int value)
+{
+	struct sophgo_vip *vip = data;
+	unsigned int readback;
+	int ret = sophgo_vip_ready(vip);
+
+	if (ret)
+		return ret;
+	if (value & ~0x10U)
+		return -EINVAL;
+	ret = regmap_update_bits(vip->map, SOPHGO_VIP_CLK_CTRL0, 0x10, value);
+	if (ret)
+		return ret;
+	return regmap_read(vip->map, SOPHGO_VIP_CLK_CTRL0, &readback);
+}
+
+/* Separate assert/deassert leaves, not an invented boot-time reset pulse.
+ * vip_sys.c:vip_toggle_reset uses assert, 20 us, deassert. A future pulse
+ * caller must serialize that entire sequence and wait after the assert
+ * readback. A failure is returned unchanged; never proceed to PHY on error.
+ */
+static inline int sophgo_vip_reset(struct sophgo_vip *vip, unsigned int mask, bool assert)
+{
+	unsigned int readback;
+	int ret = sophgo_vip_ready(vip);
+
+	if (ret)
+		return ret;
+	if (!mask || (mask & ~SOPHGO_VIP_DISPLAY_RESETS))
+		return -EINVAL;
+	ret = regmap_update_bits(vip->map, SOPHGO_VIP_RESET, mask, assert ? mask : 0);
+	if (ret)
+		return ret;
+	return regmap_read(vip->map, SOPHGO_VIP_RESET, &readback);
+}
+#endif
