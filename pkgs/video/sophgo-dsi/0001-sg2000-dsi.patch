+/* Attach is called during LT8912B probe, AFTER drm_bridge_add(). Never
+ * discover the bridge in host probe: the bridge itself needs a registered
+ * host. Each attachment gets a fresh DRM device; unplug is irreversible.
+ * host_lock serializes attachment, detach, shutdown and host removal.
+ */
+static int sophgo_kms_create(struct sophgo_dsi *dsi);
+static void sophgo_pipeline_shutdown(struct sophgo_dsi *dsi);
+static void sophgo_kms_destroy(struct sophgo_dsi *dsi)
+{
+	struct drm_device *drm = dsi->drm;
+	struct sophgo_kms *kms;
+
+	if (!drm)
+		return;
+	kms = drm->dev_private;
+	/* 7.2.2's generic ioctl unplug check is not an SRCU read section.
+	 * Our fops and connector probe wrap the entire operation in enter/exit.
+	 * Blocking commits ensure there is no commit worker left after this.
+	 */
+	drm_dev_unplug(drm);
+	mutex_lock(&kms->release_lock);
+	drm_atomic_helper_shutdown(drm);
+	sophgo_pipeline_shutdown(dsi);
+	/* Only the encoder/bridge chain has I2C-owned state. Remove it while
+	 * the bridge is alive, after draining operations and excluding close.
+	 * The host-owned connector and mode config survive until final put:
+	 * late drm_release still needs them for framebuffer/blob cleanup.
+	 */
+	/* Drop the connector state's self-reference/routing even if shutdown
+	 * could not allocate an atomic state. No probe/ioctl can enter now.
+	 */
+	if (kms->connector.state) {
+		drm_atomic_helper_connector_destroy_state(&kms->connector, kms->connector.state);
+		kms->connector.state = NULL;
+	}
+	drm_encoder_cleanup(&kms->encoder);
+	kms->connector.possible_encoders = 0;
+	kms->dsi = NULL;
+	mutex_unlock(&kms->release_lock);
+	dsi->drm = NULL;
+	drm_dev_put(drm);
+}
+
+static int sophgo_dsi_attach(struct mipi_dsi_host *host, struct mipi_dsi_device *device)
+{
+	struct sophgo_dsi *dsi = container_of(host, struct sophgo_dsi, host);
+	struct i2c_client *client;
+	struct device_link *link;
+	unsigned long flags;
+	int ret;
+
+	if (strcmp(device->name, "lt8912"))
+		return -EINVAL;
+	ret = sophgo_mac_negotiate(true, device->lanes, device->format, device->channel,
+				   device->mode_flags, &flags);
+	if (ret)
+		return ret;
+	if (device->lanes != 4)
+		return -EINVAL;
+	mutex_lock(&dsi->host_lock);
+	if (dsi->peripheral) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+	dsi->bridge = of_drm_find_and_get_bridge(dsi->bridge_node);
+	if (!dsi->bridge) {
+		ret = -EPROBE_DEFER;
+		goto unlock;
+	}
+	client = of_find_i2c_device_by_node(dsi->bridge_node);
+	if (!client) {
+		ret = -EPROBE_DEFER;
+		goto put_bridge;
+	}
+	/* Unbind the I2C consumer (including its devm DSI detach/unregister)
+	 * BEFORE host removal. Otherwise host_unregister would unregister the
+	 * same DSI child that still belongs to the I2C driver's devres.
+	 */
+	link = device_link_add(&client->dev, host->dev, DL_FLAG_AUTOREMOVE_CONSUMER);
+	put_device(&client->dev);
+	if (!link) {
+		ret = -ENOMEM;
+		goto put_bridge;
+	}
+	ret = sophgo_kms_create(dsi);
+	if (ret) {
+		device_link_del(link);
+		goto put_bridge;
+	}
+	device->mode_flags = flags;
+	dsi->peripheral = device;
+	goto unlock;
+put_bridge:
+	drm_bridge_put(dsi->bridge);
+	dsi->bridge = NULL;
+unlock:
+	mutex_unlock(&dsi->host_lock);
+	return ret;
+}
+
+static int sophgo_dsi_detach(struct mipi_dsi_host *host, struct mipi_dsi_device *device)
+{
+	struct sophgo_dsi *dsi = container_of(host, struct sophgo_dsi, host);
+	int ret = 0;
+
+	mutex_lock(&dsi->host_lock);
+	if (dsi->peripheral != device) {
+		ret = -EINVAL;
+	} else {
+		sophgo_kms_destroy(dsi);
+		drm_bridge_put(dsi->bridge);
+		dsi->bridge = NULL;
+		dsi->peripheral = NULL;
+	}
+	mutex_unlock(&dsi->host_lock);
+	return ret;
+}
