+/* GEM mappings have independent GEM lifetimes and never reference kms->dsi.
+ * read/poll only handle file events. Generic open does not touch mode objects.
+ */
+static long sophgo_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct drm_file *priv = file->private_data;
+	int idx;
+	long ret;
+
+	if (!drm_dev_enter(priv->minor->dev, &idx))
+		return -ENODEV;
+	ret = drm_ioctl(file, cmd, arg);
+	drm_dev_exit(idx);
+	return ret;
+}
+
+#ifdef CONFIG_COMPAT
+static long sophgo_compat_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct drm_file *priv = file->private_data;
+	int idx;
+	long ret;
+
+	if (!drm_dev_enter(priv->minor->dev, &idx))
+		return -ENODEV;
+	ret = drm_compat_ioctl(file, cmd, arg);
+	drm_dev_exit(idx);
+	return ret;
+}
+#endif
+
+static int sophgo_release(struct inode *inode, struct file *file)
+{
+	struct drm_file *priv = file->private_data;
+	struct drm_device *drm = priv->minor->dev;
+	struct sophgo_kms *kms = drm->dev_private;
+	int ret;
+
+	/* drm_release can drop the last file reference. Keep the lock alive
+	 * until after unlock, including when the platform has been removed.
+	 */
+	drm_dev_get(drm);
+	mutex_lock(&kms->release_lock);
+	ret = drm_release(inode, file);
+	mutex_unlock(&kms->release_lock);
+	drm_dev_put(drm);
+	return ret;
+}
