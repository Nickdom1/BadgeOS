+static int sophgo_crtc_check(struct drm_crtc *crtc, struct drm_atomic_commit *state)
+{
+	struct drm_crtc_state *new_state = drm_atomic_get_new_crtc_state(state, crtc);
+	struct sophgo_disp_timing timing;
+	int ret;
+
+	if (new_state->event)
+		return -EOPNOTSUPP;
+	if (!new_state->active)
+		return 0;
+	ret = sophgo_mode_timing(&new_state->adjusted_mode, &timing);
+	/* No parameter or DT property can bypass the unfinished pipeline gate. */
+	return ret ? ret : -EOPNOTSUPP;
+}
