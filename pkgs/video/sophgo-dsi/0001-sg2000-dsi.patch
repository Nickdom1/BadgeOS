diff --git a/interdrv/sophgo-dsi/sophgo-clocks.h b/interdrv/sophgo-dsi/sophgo-clocks.h
new file mode 100644
--- /dev/null
+++ b/interdrv/sophgo-dsi/sophgo-clocks.h
@@ -0,0 +1,114 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SOPHGO_CLOCKS_H
+#define SOPHGO_CLOCKS_H
+
+#include <linux/iopoll.h>
+#include "sophgo-trace.h"
+
+/* Linux 7.2.2 clk-cv1800.c owns these gates/parents and 0x03002840.
+ * osdrv aa542c41 vo/chip/cv181x/vo_mipi_tx.c:_init_resources enables
+ * display before DSI. CCF handles parent ordering and partial bulk unwind.
+ * sc_top is CLK_SC_TOP_VIP in clk-cv1800.c: acquire/enable before any
+ * scaler TOP access, disable last. No shared scaler reset is implied.
+ * dsi_src owns G2 bit 1 separately from DISPPLL; bulk rollback releases it
+ * on PLL readiness failure, and normal teardown follows hardware quiescence.
+ * Source enable does not prove a DSI lane clock. No rate/parent changes.
+ * cfg_reg owns CLK_CFG_REG_VIP across all direct MAC/DISP/PHY accesses.
+ * The syscon's per-access reference alone ends before the next MAC read:
+ * a trial passed VIP +0, then stalled in sophgo_mac_quiesce. Hold the same gate
+ * here until successful quiescence; the syscon may take nested references.
+ * Caller serializes with DRM commits; teardown follows hardware quiescence.
+ * bt: clk_bt_vip, CLK_BT_VIP in clk-cv1800.c, a gate on the VIP
+ * AXI bus beside CLK_DISP_VIP/CLK_DSI_MAC_VIP. Golden Debian runs it on (the
+ * vendor kernel never gates U-Boot/reset-default VIP clocks; mainline's
+ * clk_disable_unused does), and it sits beside VIP_SYS CLK_CTRL0
+ * disp_sel_bt_div1 (bit 4), the mux dsi_phy.c:_cal_pll_reg (:246-259) uses
+ * to route the D-PHY TXPLL pixel clock; the vendor mipi_tx DT also lists
+ * clk_bt (cv181x_base.dtsi:758). Optional: NULL means not held. Enabled after
+ * the bulk, disabled before it; owned by the same clocks_owned state.
+ */
+struct sophgo_clocks {
+	struct sophgo_trace *trace;
+	struct clk_bulk_data bulk[8];
+	struct clk *bt;
+	bool enabled, bt_enabled;
+};
+
+static inline void sophgo_clocks_disable(void *data)
+{
+	struct sophgo_clocks *clocks = data;
+
+	if (clocks->bt_enabled) {
+		SOPHGO_TRACE_VOID(clocks->trace, "CCF clk_bt_vip disable",
+				  clk_disable_unprepare(clocks->bt));
+		clocks->bt_enabled = false;
+	}
+	if (!clocks->enabled)
+		return;
+	SOPHGO_TRACE_VOID(clocks->trace, "CCF bulk disable",
+			  clk_bulk_disable_unprepare(ARRAY_SIZE(clocks->bulk), clocks->bulk));
+	clocks->enabled = false;
+}
+
+static inline int sophgo_clocks_enable(struct sophgo_clocks *clocks)
+{
+	bool was_enabled = clocks->enabled;
+	unsigned long rate;
+	int ret;
+
+	if (!clocks->enabled) {
+		ret = SOPHGO_TRACE_VALUE(
+		    clocks->trace, "CCF bulk prepare/enable",
+		    clk_bulk_prepare_enable(ARRAY_SIZE(clocks->bulk), clocks->bulk));
+		if (ret)
+			return ret;
+		clocks->enabled = true;
+	}
+	if (clocks->bt && !clocks->bt_enabled) {
+		ret = SOPHGO_TRACE_VALUE(clocks->trace, "CCF clk_bt_vip prepare/enable",
+					 clk_prepare_enable(clocks->bt));
+		if (ret) {
+			if (!was_enabled)
+				sophgo_clocks_disable(clocks);
+			return ret;
+		}
+		clocks->bt_enabled = true;
+	}
+	/* DISPPLL's provider returns zero while unlocked/powered down, with
+	 * CLK_GET_RATE_NOCACHE. CCF parent/rate/prepare success alone is not
+	 * readiness, including firmware-preselected and repeated requests.
+	 * Check the PLL handle itself, not a cached downstream divider.
+	 * This checks lock only; mode/rate/DSI source setup remains gated.
+	 */
+	ret = SOPHGO_TRACE_VALUE(
+	    clocks->trace, "CCF PLL readiness poll",
+	    read_poll_timeout(clk_get_rate, rate, rate, 100, 200000, false, clocks->bulk[4].clk));
+	if (ret)
+		/* Existing users must quiesce display hardware before teardown. */
+		if (!was_enabled)
+			sophgo_clocks_disable(clocks);
+	return ret;
+}
+
+/* Zero-initialized, device-lifetime storage; get once, enable only after the
+ * integration gate. LIFO devres runs disable before putting the handles: an
+ * optional bt handle must be acquired (with its own devres put) BEFORE this
+ * call so that the disable registered here still runs first.
+ */
+static inline int sophgo_clocks_get(struct device *dev, struct sophgo_clocks *clocks)
+{
+	static const char *const names[] = {
+	    "sc_top", "clk_disp", "clk_dsi", "dsi_esc", "disppll", "disp_src", "dsi_src", "cfg_reg",
+	};
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(clocks->bulk); i++)
+		clocks->bulk[i].id = names[i];
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(clocks->bulk), clocks->bulk);
+	if (ret)
+		return ret;
+	return devm_add_action_or_reset(dev, sophgo_clocks_disable, clocks);
+}
+
+#endif
diff --git a/interdrv/sophgo-dsi/sophgo-disp.h b/interdrv/sophgo-dsi/sophgo-disp.h
new file mode 100644
--- /dev/null
+++ b/interdrv/sophgo-dsi/sophgo-disp.h
@@ -0,0 +1,268 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SOPHGO_DISP_H
+#define SOPHGO_DISP_H
+
+/*
+ * sophgo/osdrv aa542c41df94f7bc656cb740f6622a5dca7dc403:
+ * interdrv/vo/chip/cv181x/vo_mipi_tx.c:_fill_disp_timing;
+ * interdrv/vpss/chip/cv181x/{scaler.c,scaler_reg.h,reg_disp.h}.
+ * Callers provide readl/writel and __iomem (linux/io.h in the driver).
+ * Pure calculations use unsigned int (at least 32 bits), no kernel ABI.
+ */
+#define SOPHGO_DISP_CFG 0x00
+#define SOPHGO_DISP_TOTAL 0x04
+#define SOPHGO_DISP_VSYNC 0x08
+#define SOPHGO_DISP_VFDE 0x0c
+#define SOPHGO_DISP_VMDE 0x10
+#define SOPHGO_DISP_HSYNC 0x14
+#define SOPHGO_DISP_HFDE 0x18
+#define SOPHGO_DISP_HMDE 0x1c
+#define SOPHGO_DISP_PAT_CFG 0x94
+#define SOPHGO_DISP_PAT_COLOR0 0x98
+#define SOPHGO_DISP_PAT_COLOR1 0x9c
+#define SOPHGO_DISP_CACHE 0xc0
+#define SOPHGO_DISP_SIZE 0xc4 /* exclusive end of registers used here */
+#define SOPHGO_DISP_TGEN 0x80
+#define SOPHGO_DISP_POLARITY 0x60
+#define SOPHGO_DISP_TIMING_MASK 0x3fff3fff
+#define SOPHGO_DISP_PATTERN_MASK 0x1f000016
+#define SOPHGO_DISP_PATTERN_OFF_MASK 0x16
+#define SOPHGO_DISP_WINDOW_BG 0x20
+
+/*
+ * Vendor display-subsystem initialization. scaler.c:sclr_ctrl_init()
+ * runs sclr_top_set_cfg() (:708), sclr_disp_reg_shadow_sel(false) (:2285) and
+ * sclr_disp_set_cfg() (:3124) once at driver init; golden Debian therefore
+ * reads TOP_CFG0 0x80000008, TOP_CFG1 0x00ff1200, DISP_CFG 0x000420e0 and
+ * DISP_CACHE bit 0 = 1. Missing initialization previously left reset values.
+ * scaler_reg.h: REG_SCL_TOP_CFG0 +0x00, REG_SCL_TOP_CFG1 +0x04,
+ * REG_SCL_TOP_SHD +0x10, REG_SCL_DISP_CACHE +0xc0.
+ */
+#define SOPHGO_SC_TOP_CFG0 0x00
+#define SOPHGO_SC_TOP_CFG1 0x04
+#define SOPHGO_SC_TOP_SHD 0x10
+/* scaler.c:714 sclr_top_set_cfg: (force_clk_enable << 31) | (ip_trig_src << 3);
+ * sclr_ctrl_init:4474-4475 sets ip_trig_src = true, force_clk_enable = true.
+ */
+#define SOPHGO_SC_TOP_CFG0_INIT 0x80000008U
+/* scaler.h:291 union sclr_top_cfg_01 as sclr_top_set_cfg:719-728 fills it from
+ * sclr_ctrl_init:4476-4481: sc_d/v1/v2/v3_enable = 0 (bits 0-3), disp_enable
+ * = 0 (bit 4), disp_from_sc = 0 = DRAM (bit 8; 1 = the idle scaler-D),
+ * sc_d_src = 0 (bit 9), sc_debug_en = 1 (bit 12), qos_en = 0xff (bits 16-23).
+ */
+#define SOPHGO_SC_TOP_CFG1_INIT 0x00ff1200U
+#define SOPHGO_SC_TOP_REG_DONE 0x1U    /* scaler.c:774 sclr_top_reg_done: CFG0 bit 0 */
+#define SOPHGO_SC_TOP_FORCE_UP 0xffU   /* scaler.c:783 sclr_top_reg_force_up: SHD[7:0] */
+/* scaler.c:4552-4553 sclr_ctrl_init: _reg_write(REG_SCL_TOP_SHD, 1<<9),
+ * "reg_shrd_sel(bit[9]): 1: raw register", issued after sclr_top_set_cfg and
+ * before reg_done/force_up. It selects the raw (working) scaler-top bank for
+ * readback; without it the fenced dump reads the shadow bank, where TOP_CFG1
+ * bits 8/9 (disp_from_sc/sc_d_src) show reset 1/0 (0x00ff1100), not the
+ * working 0/1 golden reads (0x00ff1200), and TOP_SHD reads 0, not 0x200
+ * in the reference. Full write like the vendor _reg_write; the force_up RMW below then sets SHD[7:0] and preserves this
+ * bit. Mirrors the DISP working-bank select (SOPHGO_DISP_READ_WORKING).
+ */
+#define SOPHGO_SC_TOP_SHRD_SEL (1U << 9)
+/* scaler.c:3128-3151 sclr_disp_set_cfg: disp_from_sc (bit 0) | fmt << 12 |
+ * sync_ext << 4 | tgen_en << 7 under mask 0x0000f09f, with
+ * sclr_ctrl_init:4483-4488 disp_from_sc = 0, sync_ext = 0, fmt =
+ * SCL_FMT_RGB_PLANAR (scaler.h:184, value 2). The tgen bit is excluded here:
+ * pipeline sequencing (timing, pattern, TGEN, commit) owns it.
+ */
+#define SOPHGO_DISP_CFG_INIT_MASK 0xf01fU
+#define SOPHGO_DISP_CFG_INIT 0x2000U
+#define SOPHGO_DISP_CACHE_MODE 0x1U    /* scaler.c:3152: DISP_CACHE bit 0 = cache_mode (true, :4485) */
+#define SOPHGO_DISP_READ_WORKING (1U << 18) /* scaler.c:2287: 0 reads shadow, 1 reads working */
+
+struct sophgo_disp_axis {
+	unsigned int total, sync, active;
+};
+
+struct sophgo_disp_timing {
+	struct sophgo_disp_axis h, v;
+	unsigned int polarity;
+};
+
+/*
+ * DRM coordinates -> vendor sync-origin counters, in pixels / lines.
+ * reg_disp.h: each counter is 14 bits, packed end:16 | start.
+ * _fill_disp_timing: sync starts at 1, ends at sync width (inclusive);
+ * active starts at 1 + sync width + back porch; total stores count - 1.
+ * Require one front-porch count so the inclusive active end fits in total.
+ * Return -1 on invalid input, leaving output unchanged. Validate before
+ * subtracting or adding, including the full 16384-count hardware boundary.
+ */
+static inline int sophgo_disp_calc_axis(unsigned int display, unsigned int sync_start,
+					unsigned int sync_end, unsigned int total,
+					struct sophgo_disp_axis *out)
+{
+	struct sophgo_disp_axis axis;
+	unsigned int start, end;
+
+	if (!display || total > 16384 || display >= sync_start || sync_start >= sync_end ||
+	    sync_end > total)
+		return -1;
+	start = 1 + total - sync_start;
+	end = start + display - 1;
+	if (end >= total)
+		return -1;
+	axis.total = total - 1;
+	axis.sync = ((sync_end - sync_start) << 16) | 1;
+	axis.active = (end << 16) | start;
+	*out = axis;
+	return 0;
+}
+
+/* All accesses are relative to the exclusively owned, named disp resource.
+ * DRM commits serialize these RMWs. No IRQ/host-transfer path may write them.
+ */
+static inline void sophgo_disp_update(void __iomem *disp, unsigned int reg, unsigned int mask,
+				      unsigned int value)
+{
+	unsigned int old = readl(disp + reg);
+
+	/* Bit 16 is a command, not configuration: never replay a read-back
+	 * force request during an unrelated CFG RMW. Only commit sets it.
+	 */
+	if (reg == SOPHGO_DISP_CFG)
+		old &= ~(1U << 16);
+	writel((old & ~mask) | (value & mask), disp + reg);
+}
+
+/* scaler.c:sclr_disp_tgen_enable. Caller must own enabled display clocks. */
+static inline void sophgo_disp_tgen(void __iomem *disp, int enable)
+{
+	sophgo_disp_update(disp, SOPHGO_DISP_CFG, SOPHGO_DISP_TGEN, enable ? SOPHGO_DISP_TGEN : 0);
+}
+
+/* scaler.c:sclr_disp_set_timing, but deliberately leave tgen OFF until the
+ * caller has configured the pattern and completed the rest of the pipeline.
+ * Preserve reserved bits using reg_disp.h's 14-bit masks.
+ */
+static inline void sophgo_disp_set_timing(void __iomem *disp, const struct sophgo_disp_timing *t)
+{
+	sophgo_disp_tgen(disp, 0);
+	sophgo_disp_update(disp, SOPHGO_DISP_CFG, SOPHGO_DISP_POLARITY, t->polarity);
+	sophgo_disp_update(disp, SOPHGO_DISP_TOTAL, SOPHGO_DISP_TIMING_MASK,
+			   (t->h.total << 16) | t->v.total);
+	sophgo_disp_update(disp, SOPHGO_DISP_VSYNC, SOPHGO_DISP_TIMING_MASK, t->v.sync);
+	sophgo_disp_update(disp, SOPHGO_DISP_VFDE, SOPHGO_DISP_TIMING_MASK, t->v.active);
+	sophgo_disp_update(disp, SOPHGO_DISP_VMDE, SOPHGO_DISP_TIMING_MASK, t->v.active);
+	sophgo_disp_update(disp, SOPHGO_DISP_HSYNC, SOPHGO_DISP_TIMING_MASK, t->h.sync);
+	sophgo_disp_update(disp, SOPHGO_DISP_HFDE, SOPHGO_DISP_TIMING_MASK, t->h.active);
+	sophgo_disp_update(disp, SOPHGO_DISP_HMDE, SOPHGO_DISP_TIMING_MASK, t->h.active);
+}
+
+/* scaler.c:sclr_disp_set_pattern and sclr_disp_enable_window_bgcolor.
+ * vo.c:VO_IOCTL_PATTERN's patterns[6] = FULL(0), COLOR_BAR(7). 10-bit RGB.
+ * Keep bank/other bits, do not replay a whole observed PAT_CFG value.
+ * Unlike the vendor leaf, configuring colourbar does NOT start tgen.
+ */
+static inline void sophgo_disp_pattern(void __iomem *disp, int enable)
+{
+	sophgo_disp_update(disp, SOPHGO_DISP_PAT_CFG, SOPHGO_DISP_WINDOW_BG, 0);
+	if (!enable) {
+		sophgo_disp_update(disp, SOPHGO_DISP_PAT_CFG, SOPHGO_DISP_PATTERN_OFF_MASK, 0);
+		return;
+	}
+	writel(0x03ff03ff, disp + SOPHGO_DISP_PAT_COLOR0);
+	sophgo_disp_update(disp, SOPHGO_DISP_PAT_COLOR1, 0x3ff, 0x3ff);
+	sophgo_disp_update(disp, SOPHGO_DISP_PAT_CFG, SOPHGO_DISP_PATTERN_MASK, 0x07000002);
+}
+
+/* scaler.c:sclr_disp_reg_shadow_sel/mask/force_up. Read the WORKING bank
+ * (sclr_disp_reg_shadow_sel(false), as sclr_ctrl_init:4539 and vo.c:2124
+ * select it once), so masked timing/pattern RMWs start from the live values
+ * and the fenced dump (sophgo-dump.h) shows what the display runs. Reading
+ * the shadow bank previously returned reset-default timing. DISP_CFG
+ * bit 16 triggers display only. Scaler-top reg_done/force_up are issued once
+ * by sophgo_sc_top_init(), the vendor init order; they are never replayed
+ * from this display-only commit. Caller serializes the entire
+ * begin/program/commit under DRM and owns enabled clocks. Readback drains
+ * writes; it does not prove frame latching.
+ */
+static inline void sophgo_disp_shadow_begin(void __iomem *disp)
+{
+	sophgo_disp_update(disp, SOPHGO_DISP_CFG, SOPHGO_DISP_READ_WORKING, SOPHGO_DISP_READ_WORKING);
+	sophgo_disp_update(disp, SOPHGO_DISP_CFG, 1U << 17, 1U << 17);
+}
+
+static inline void sophgo_disp_shadow_commit(void __iomem *disp)
+{
+	sophgo_disp_update(disp, SOPHGO_DISP_CFG, 1U << 17, 0);
+	sophgo_disp_update(disp, SOPHGO_DISP_CFG, 1U << 16, 1U << 16);
+	readl(disp + SOPHGO_DISP_CFG);
+}
+
+/* scaler.c:sclr_disp_set_cfg (:3124) fields for the pattern-generator
+ * source as sclr_ctrl_init programs them: RGB planar format, DRAM (not the
+ * idle scaler-D) as the display source, no external sync, cache mode on.
+ * Called under the shadow mask like the vendor (sclr_disp_reg_set_shadow_mask
+ * true at :3136/:3141, false at :3168); the caller's commit publishes it.
+ * The DRAM-path plumbing the vendor also writes there (sclr_disp_set_mem,
+ * PITCH_Y burst, the CSC matrices at their identity defaults) stays out:
+ * this path does not configure or own framebuffer scanout.
+ */
+static inline void sophgo_disp_init(void __iomem *disp)
+{
+	sophgo_disp_update(disp, SOPHGO_DISP_CFG, SOPHGO_DISP_CFG_INIT_MASK, SOPHGO_DISP_CFG_INIT);
+	sophgo_disp_update(disp, SOPHGO_DISP_CACHE, SOPHGO_DISP_CACHE_MODE, SOPHGO_DISP_CACHE_MODE);
+	readl(disp + SOPHGO_DISP_CFG);
+}
+
+#define SOPHGO_SC_TOP_SIZE 0x74
+/* scaler.c:sclr_top_set_cfg (:708) as sclr_ctrl_init (:4515) calls it: plain
+ * writes of TOP_CFG0 (force the scaler-top clocks on, IMG_D trigger source)
+ * and TOP_CFG1 (all scaler instances off, display fed from DRAM rather than
+ * the idle scaler-D), then sclr_top_reg_done (:774, CFG0 bit 0, RMW) and
+ * sclr_top_reg_force_up (:783, SHD[7:0] = 0xff, RMW); golden reads both
+ * trigger fields back as 0. The port previously refused these two because
+ * they mark every scaler register valid; on mainline nothing else drives the
+ * scaler, and the vendor does exactly this once at init. Not a DISP_CFG
+ * RMW: TOP_CFG0 bit 16 is ordinary configuration here. Between the CFG
+ * writes and reg_done/force_up it selects the raw readback bank
+ * (reg_shrd_sel, SHD bit 9), the vendor order, so bits 8/9 read back the
+ * working values instead of the shadow bank.
+ * Caller owns CLK_SC_TOP_VIP and serializes with all other TOP accesses.
+ */
+static inline void sophgo_sc_top_init(void __iomem *top)
+{
+	writel(SOPHGO_SC_TOP_CFG0_INIT, top + SOPHGO_SC_TOP_CFG0);
+	writel(SOPHGO_SC_TOP_CFG1_INIT, top + SOPHGO_SC_TOP_CFG1);
+	writel(SOPHGO_SC_TOP_SHRD_SEL, top + SOPHGO_SC_TOP_SHD);
+	writel(readl(top + SOPHGO_SC_TOP_CFG0) | SOPHGO_SC_TOP_REG_DONE, top + SOPHGO_SC_TOP_CFG0);
+	writel((readl(top + SOPHGO_SC_TOP_SHD) & ~SOPHGO_SC_TOP_FORCE_UP) | SOPHGO_SC_TOP_FORCE_UP,
+	       top + SOPHGO_SC_TOP_SHD);
+	readl(top + SOPHGO_SC_TOP_CFG0);
+}
+/* scaler.c:sclr_disp_set_intf(MIPI) selects SCLR_VO_SEL_DISABLE (0).
+ * This mux disables the parallel VO interface, not the DSI stream.
+ * sc_top is an exclusively claimed platform resource here; the driver
+ * must not coexist with a second raw scaler TOP writer. Preserve high bits.
+ * Caller owns CLK_SC_TOP_VIP and serializes with all other TOP accesses.
+ */
+static inline void sophgo_disp_mux_dsi(void __iomem *top)
+{
+	sophgo_disp_update(top, 0x70, 0xf, 0);
+	readl(top + 0x70);
+}
+
+static inline void sophgo_disp_enable(void __iomem *disp, const struct sophgo_disp_timing *timing,
+				      int pattern)
+{
+	sophgo_disp_shadow_begin(disp);
+	sophgo_disp_init(disp);
+	sophgo_disp_set_timing(disp, timing);
+	sophgo_disp_pattern(disp, pattern);
+	sophgo_disp_tgen(disp, 1);
+	sophgo_disp_shadow_commit(disp);
+}
+
+static inline void sophgo_disp_disable(void __iomem *disp)
+{
+	sophgo_disp_shadow_begin(disp);
+	sophgo_disp_tgen(disp, 0);
+	sophgo_disp_pattern(disp, 0);
+	sophgo_disp_shadow_commit(disp);
+}
+#endif
diff --git a/interdrv/sophgo-dsi/sophgo-dphy.h b/interdrv/sophgo-dsi/sophgo-dphy.h
new file mode 100644
--- /dev/null
+++ b/interdrv/sophgo-dsi/sophgo-dphy.h
@@ -0,0 +1,225 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SOPHGO_DPHY_H
+#define SOPHGO_DPHY_H
+
+/* Source correspondence: sophgo/osdrv aa542c41df94f7bc656cb740f6622a5dca7dc403,
+ * interdrv/vpss/chip/cv181x/dsi_phy.c: dphy_dsi_disable_lanes,
+ * dphy_dsi_set_lane, dphy_dsi_lane_en, _cal_pll_reg, dphy_dsi_set_pll,
+ * dphy_set_hs_settle; offsets from scaler_reg.h. This is not binary identity.
+ * Callers supply linux/io.h; all MMIO is relative to managed dphy resources.
+ */
+#define SOPHGO_DPHY_SIZE 0xcc
+#define SOPHGO_DPHY_EN 0x00
+#define SOPHGO_DPHY_HS 0x14
+#define SOPHGO_DPHY_PLL 0x6c
+#define SOPHGO_DPHY_UPDATE 0x8c
+#define SOPHGO_DPHY_SET 0x90
+#define SOPHGO_DPHY_MAP 0x9c
+#define SOPHGO_DPHY_PN 0xa0
+
+struct sophgo_dphy_lanes {
+	unsigned int map, pn, enable, count;
+};
+
+/* Physical pad index -> role: 0 clock, 1..4 data0..3, 5 unused.
+ * Exactly one clock and contiguous logical data lanes; no duplicate roles.
+ * pn is a five-bit physical-pad mask; phase selects 90 degrees on clock.
+ * Preamble is supplied by the PLL calculation (lane rate > 1500000 kbit/s).
+ * Pure helpers return -1 without changing output on invalid input.
+ */
+static inline int sophgo_dphy_calc_lanes(const unsigned int roles[5], unsigned int pn,
+					 unsigned int phase, unsigned int preamble,
+					 struct sophgo_dphy_lanes *out)
+{
+	struct sophgo_dphy_lanes p = {0};
+	unsigned int seen = 0, i;
+
+	if (pn > 31 || phase > 1 || preamble > 1)
+		return -1;
+	for (i = 0; i < 5; i++) {
+		unsigned int role = roles[i];
+
+		if (role > 5 || (role == 5 && (pn & (1U << i))))
+			return -1;
+		p.map |= role << (4 * i);
+		if (role == 5)
+			continue;
+		if (seen & (1U << role))
+			return -1;
+		seen |= 1U << role;
+		if (role)
+			p.count++;
+		else if (phase)
+			p.map |= 1U << (24 + i);
+	}
+	if (!p.count || seen != (1U << (p.count + 1)) - 1)
+		return -1;
+	p.pn = pn;
+	p.enable = seen | (preamble << 5);
+	*out = p;
+	return 0;
+}
+
+struct sophgo_dphy_pll {
+	unsigned int txpll, loop, set, vip_div, preamble;
+};
+
+/* DSI-only _cal_pll_reg with the vendor's 25 MHz reference assumption:
+ * pixel_khz in kHz, bits per pixel 16/18/24/30, 1..4 data lanes.
+ * VCORx10000 is lane MHz * 10000; VCOCx1000 is gained lane rate in kHz.
+ * Preserve every integer floor (including divide-by-133 and loop rounding).
+ * Use wide intermediates, reject the vendor's u8/u32 truncation cases and
+ * unencodable gain/dividers instead of wrapping. This is encoding validation,
+ * not a claim that every representable rate is electrically qualified.
+ */
+static inline int sophgo_dphy_calc_pll(unsigned int pixel_khz, unsigned int lanes,
+				       unsigned int bits, unsigned int reference_khz,
+				       struct sophgo_dphy_pll *out)
+{
+	struct sophgo_dphy_pll p;
+	unsigned long long rate, vcor, vco, set;
+	unsigned int gain = 1, dig = 0, divout, div, loop_c, loop;
+
+	if (!pixel_khz || !lanes || lanes > 4 || reference_khz != 25000 ||
+	    (bits != 16 && bits != 18 && bits != 24 && bits != 30))
+		return -1;
+	rate = (unsigned long long)pixel_khz * bits;
+	/* The pinned source multiplies by ten before dividing by lane count. */
+	if (rate * 10 > 0xffffffffULL)
+		return -1;
+	vcor = rate * 10 / lanes;
+	while (gain <= (25000000ULL / vcor) / 2) {
+		gain <<= 1;
+		dig++;
+	}
+	divout = dig < 3 ? dig : 3;
+	if (gain > 128 || dig - divout > 1)
+		return -1; /* TXPLL 0x7ff has only one div_sel bit. */
+	vco = vcor * gain / 10;
+	div = vco / pixel_khz;
+	if (!div || div > 255)
+		return -1;
+	loop_c = 8 * ((vco / 133 / 8) / 1000);
+	loop = loop_c > 32 ? 3 : loop_c / 8;
+	if (!loop || loop > 3)
+		return -1; /* Reject loop_c == 32: vendor value 4 spills its mask. */
+	set = ((900000ULL * (loop * 8)) << 26) / vco;
+	if (!set || set > 0xffffffffULL)
+		return -1;
+	p.vip_div = div > 127 ? 0 : 0x10;
+	if (div > 127)
+		div >>= 1;
+	p.txpll = ((dig - divout) << 10) | (divout << 8) | div;
+	p.loop = loop << 20;
+	p.set = set;
+	p.preamble = rate / lanes > 1500000;
+	*out = p;
+	return 0;
+}
+
+/* Raw TX timing counts, NOT nanoseconds. Source exposes three u8 fields;
+ * no documented time conversion is inferred. Preserve HS_CFG1 low byte.
+ */
+static inline int sophgo_dphy_calc_hs(unsigned int prepare, unsigned int zero, unsigned int trail,
+				      unsigned int *out)
+{
+	if (prepare > 255 || zero > 255 || trail > 255)
+		return -1;
+	*out = (trail << 24) | (zero << 16) | (prepare << 8);
+	return 0;
+}
+
+/* Caller owns enabled clocks and DRM serialization. Only pass validated
+ * plans from the pure helpers. These leaves do not establish LP-11 or power.
+ */
+static inline void sophgo_dphy_update(void __iomem *phy, unsigned int reg, unsigned int mask,
+				      unsigned int value)
+{
+	writel((readl(phy + reg) & ~mask) | (value & mask), phy + reg);
+}
+
+static inline void sophgo_dphy_disable_lanes(void __iomem *phy)
+{
+	sophgo_dphy_update(phy, SOPHGO_DPHY_EN, 0x3f, 0);
+	sophgo_dphy_update(phy, SOPHGO_DPHY_MAP, 0xfffff, 0);
+	readl(phy + SOPHGO_DPHY_EN);
+}
+
+/* vo_mipi_tx.c:mipi_tx_set_combo_dev_cfg: disable, map, PN/phase, enable.
+ * Aggregate per-pad RMWs while lanes are disabled; reset unused-pad fields.
+ */
+static inline void sophgo_dphy_set_lanes(void __iomem *phy, const struct sophgo_dphy_lanes *p)
+{
+	sophgo_dphy_disable_lanes(phy);
+	sophgo_dphy_update(phy, SOPHGO_DPHY_MAP, 0x1f077777, p->map);
+	sophgo_dphy_update(phy, SOPHGO_DPHY_PN, 0x1f, p->pn);
+	sophgo_dphy_update(phy, SOPHGO_DPHY_EN, 0x3f, p->enable);
+}
+
+/* Shared-clock integration is mandatory, not an arbitrary physical mapping.
+ * vip_div(ctx, value) must apply mask 0x10 to VIP_SYS_VIP_CLK_CTRL0 (+0x18)
+ * through its agreed owner before any PHY PLL write, returning 0 or errno.
+ * sophgo_vip_div supplies the DT syscon owner callback; callers pass their
+ * acquired sophgo_vip as ctx. NULL fails without MMIO. Caller must also resolve CLK_DISPPLL's
+ * 0x03002840 dependency through CCF; this helper cannot enable a pipeline.
+ */
+static inline int sophgo_dphy_set_pll(void __iomem *phy, const struct sophgo_dphy_pll *p,
+				      int (*vip_div)(void *, unsigned int), void *ctx)
+{
+	int ret;
+
+	if (!vip_div)
+		return -1;
+	ret = vip_div(ctx, p->vip_div);
+	if (ret)
+		return ret;
+	sophgo_dphy_update(phy, SOPHGO_DPHY_PLL, 0x300000, p->loop);
+	sophgo_dphy_update(phy, SOPHGO_DPHY_PLL, 0x7ff, p->txpll);
+	writel(p->set, phy + SOPHGO_DPHY_SET);
+	sophgo_dphy_update(phy, SOPHGO_DPHY_UPDATE, 1, 0);
+	sophgo_dphy_update(phy, SOPHGO_DPHY_UPDATE, 1, 1);
+	return 0;
+}
+
+static inline void sophgo_dphy_set_hs(void __iomem *phy, unsigned int hs)
+{
+	sophgo_dphy_update(phy, SOPHGO_DPHY_HS, 0xffffff00, hs);
+}
+/* osdrv aa542c41 interdrv/vpss/chip/cv181x/dsi_phy.c:dphy_init(MIPI):
+ * all five pads are used, so lptrx is zero and the vendor writes the full PD
+ * word. Historical working Debian reads PD=0; a lane-only mask retained
+ * 0x2000. Its bit meaning is undocumented; reproduce the vendor write without
+ * claiming PLL lock or electrical LP-11. Other analog masks stay unchanged.
+ * The final 0x74 setting follows dphy_dsi_analog_setting(false).
+ */
+static inline void sophgo_dphy_lp11(void __iomem *phy)
+{
+	writel(0, phy + 0x64);
+	sophgo_dphy_update(phy, 0x4c, 0x001f001f, 0);
+	sophgo_dphy_update(phy, 0x54, 0x1f1f, 0);
+	sophgo_dphy_update(phy, 0x50, 0x1f1f1f1f, 0);
+	sophgo_dphy_update(phy, 0xc4, 0x1f1f, 0);
+	sophgo_dphy_update(phy, 0xc8, 0x1f1f, 0);
+	writel(0x100, phy + 0x0c);
+	writel(0x100, phy + 0x10);
+	sophgo_dphy_update(phy, 0xc0, 0xfffff, 0);
+	sophgo_dphy_update(phy, 0xb4, 1, 0);
+	sophgo_dphy_update(phy, 0x60, 0x10000, 0);
+	sophgo_dphy_update(phy, 0x5c, 0x1f000000, 0);
+	sophgo_dphy_update(phy, 0x88, 0xfffff, 0);
+	sophgo_dphy_update(phy, 0x74, 0x3ff, 0);
+}
+
+/* sclr_disp_set_intf(DISABLE) -> dphy_init: PD=0x1f1f.
+ * Disable lanes and overrides first, then power down the owned pads and
+ * drain writes BEFORE releasing CCF sources. Do not power off shared PLLs.
+ * No vendor evidence requires a VIP reset pulse on this path.
+ */
+static inline void sophgo_dphy_power_down(void __iomem *phy)
+{
+	sophgo_dphy_disable_lanes(phy);
+	sophgo_dphy_update(phy, 0x44, 0x1f1f1f1f, 0);
+	sophgo_dphy_update(phy, 0x64, 0x1f1f, 0x1f1f);
+	readl(phy + 0x64);
+}
+#endif
diff --git a/interdrv/sophgo-dsi/sophgo-dsi.c b/interdrv/sophgo-dsi/sophgo-dsi.c
new file mode 100644
--- /dev/null
+++ b/interdrv/sophgo-dsi/sophgo-dsi.c
@@ -0,0 +1,1134 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * SG2000 display / video-only DSI host with a manual pinstripe path.
+ * HAL reference: sophgo/osdrv aa542c41, interdrv/vpss/chip/cv181x/
+ * scaler.c and dsi_phy.c, interdrv/base/chip/cv181x/vip_sys.c.
+ * The manual path owns clocks, PHY, MAC and bridge. General DRM active
+ * commits remain blocked; this is not framebuffer scanout support.
+ */
+#include <linux/clk.h>
+#include <linux/clk-provider.h>
+#include <linux/debugfs.h>
+#include <linux/i2c.h>
+#include <linux/io.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_graph.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/completion.h>
+#include <linux/ktime.h>
+#include <linux/string.h>
+
+#include <drm/bridge/lt8912b.h>
+#include <drm/drm_atomic.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_bridge.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_edid.h>
+#include <drm/drm_encoder.h>
+#include <drm/drm_file.h>
+#include <drm/drm_fourcc.h>
+#include <drm/drm_gem_dma_helper.h>
+#include <drm/drm_gem_framebuffer_helper.h>
+#include <drm/drm_ioctl.h>
+#include <drm/drm_managed.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_probe_helper.h>
+
+/* Primitive headers compose in dependency order. */
+// clang-format off
+#include "sophgo-clocks.h"
+#include "sophgo-disp.h"
+#include "sophgo-dphy.h"
+#include "sophgo-dump.h"
+#include "sophgo-mac.h"
+#include "sophgo-vip.h"
+#include "sophgo-link.h"
+#include "sophgo-graph.h"
+#include "sophgo-pipeline.h"
+// clang-format on
+
+/* Opt-in console breadcrumbs for one supervised manual experiment. */
+static bool pinstripe_trace;
+module_param(pinstripe_trace, bool, 0444);
+MODULE_PARM_DESC(pinstripe_trace, "Log manual pinstripe call boundaries at error level");
+
+static bool mac_no_eot;
+module_param(mac_no_eot, bool, 0444);
+MODULE_PARM_DESC(mac_no_eot,
+		 "Supervised experiment: drop the DSI MAC EoT bit (HS_0 0x26000000 -> 0x22000000)");
+
+/* Fenced register snapshots at the clock-owned pipeline points (sophgo-dump.h).
+ * Off by default: an unfenced capture wedged the badge, so
+ * only a supervised trial opts in, and only together with pinstripe_trace.
+ */
+static bool pinstripe_snapshot;
+module_param(pinstripe_snapshot, bool, 0444);
+MODULE_PARM_DESC(pinstripe_snapshot,
+		 "Supervised experiment: capture fenced register pages at prepare/MAC-request/complete");
+
+/* Also read the D-PHY block (dphy, fenced 0x00-0xc8). A SECOND
+ * opt-in on top of pinstripe_snapshot, because the D-PHY page wedged Debian on
+ * a raw userspace read; here it is an in-kernel readl of the driver's own
+ * already-mapped, clock-owned window (sophgo-dump.h). Answers "did the PLL
+ * config land, are the lanes enabled?" independently of pipeline status.
+ * Supervised only: default off.
+ */
+static bool pinstripe_dphy;
+module_param(pinstripe_dphy, bool, 0444);
+MODULE_PARM_DESC(pinstripe_dphy,
+		 "Supervised experiment (needs pinstripe_snapshot): also capture the fenced D-PHY block");
+
+/* hold clk_bt_vip for the pipeline (sophgo-clocks.h). Golden
+ * Debian runs it on; mainline gates it at boot. Default on; a supervised
+ * trial may clear it to isolate the gate.
+ */
+static bool vip_bt_clock = true;
+module_param(vip_bt_clock, bool, 0444);
+MODULE_PARM_DESC(vip_bt_clock, "Hold clk_bt_vip (CLK_BT_VIP) while the pipeline owns its clocks");
+
+/* the vendor sclr_dsi_set_mode(HS) (vo_mipi_tx.c:mipi_tx_enable)
+ * writes the DSI MAC HS request and returns without polling. Default on so a
+ * MAC HS poll timeout is non-fatal and the pipeline still enables the
+ * downstream, matching the vendor; clear it to restore the fatal -110 abort.
+ */
+static bool mac_fire_and_forget = true;
+module_param(mac_fire_and_forget, bool, 0444);
+MODULE_PARM_DESC(mac_fire_and_forget, "Do not abort on the MAC HS poll timeout (vendor sclr_dsi_set_mode model)");
+
+static bool pattern_generator;
+module_param(pattern_generator, bool, 0444);
+MODULE_PARM_DESC(pattern_generator, "Request colourbar (active modesets remain unsupported)");
+
+enum sophgo_resource {
+	SOPHGO_SC_TOP,
+	SOPHGO_DISP,
+	SOPHGO_DSI_MAC,
+	SOPHGO_DPHY,
+};
+
+struct sophgo_kms {
+	struct drm_connector connector;
+	struct mutex release_lock;
+	struct drm_plane plane;
+	struct drm_crtc crtc;
+	struct drm_encoder encoder;
+	struct sophgo_dsi *dsi;
+};
+
+struct sophgo_host_bridge {
+	struct drm_bridge bridge;
+	struct sophgo_dsi *dsi;
+};
+
+struct sophgo_dsi {
+	struct drm_device *drm;
+	struct drm_bridge *bridge;
+	struct device_node *bridge_node;
+	struct sophgo_dphy_lanes lane_config;
+	struct mipi_dsi_host host;
+	struct mipi_dsi_device *peripheral;
+	struct mutex host_lock;
+	struct mutex commit_lock;
+	struct drm_bridge *host_bridge;
+	struct sophgo_pipeline pipeline;
+	struct clk *esc_parent;
+	void __iomem *regs[4];
+	struct sophgo_clocks clocks;
+	struct sophgo_vip vip;
+	struct sophgo_mac mac;
+	/* Opt-in page snapshots for the Debian diff; memory only outside the pipeline. */
+	struct sophgo_dump *dump;
+	struct sophgo_dump_sources dump_sources;
+	struct debugfs_blob_wrapper dump_blob;
+	struct dentry *debugfs;
+	/* General KMS stays disabled; the manual command owns its own request. */
+	bool pipeline_ready;
+	bool manual_selected, manual_request, terminal;
+};
+
+/* Error level is intentional: this image boots with loglevel=4. Do not
+ * use deferred/rate-limited logging: a missing before marker defeats this
+ * experiment. No register reads, locks or recovery actions in this sink.
+ */
+static void sophgo_pinstripe_trace(void *ctx, const char *label, bool returned)
+{
+	struct sophgo_dsi *dsi = ctx;
+	struct sophgo_trace *trace = &dsi->pipeline.link.trace;
+
+	if (returned)
+		WRITE_ONCE(trace->returned, label);
+	else
+		WRITE_ONCE(trace->entered, label);
+	dev_err(dsi->host.dev, "pinstripe trace %s: %s\n", returned ? "returned" : "enter", label);
+}
+
+/* Runs only from the clock-owned pipeline points (prepare, MAC request,
+ * complete), under commit_lock. It reads the fenced prefix of the same five
+ * pages as the golden Debian dump, plus D-PHY only under its separate opt-in.
+ * One console line before the capture and one after, plus a trace mark per
+ * block, makes any stall attributable to a page.
+ */
+static void sophgo_pipeline_snapshot(struct sophgo_pipeline *p, const char *label)
+{
+	struct sophgo_dsi *dsi = container_of(p, struct sophgo_dsi, pipeline);
+	int ret;
+
+	dev_err(dsi->host.dev, "pinstripe registers %s: begin\n", label);
+	ret = sophgo_dump_capture(dsi->dump, &dsi->dump_sources, label,
+				  p->link.clocks_owned && dsi->clocks.enabled, ktime_get_ns(),
+				  &p->link.trace);
+	dev_err(dsi->host.dev, "pinstripe registers %s: %d\n", label, ret);
+}
+
+static void sophgo_dump_free(void *data) { kvfree(data); }
+static void sophgo_dump_unmap(void *data) { iounmap(data); }
+static void sophgo_debugfs_remove(void *data) { debugfs_remove(data); }
+
+/* Map the always-on clock controller page without claiming the CCF provider's
+ * region, resolve the physical addresses for the reader, and publish the ring
+ * as a debugfs blob. Blocks whose DT window is shorter than a page are skipped.
+ */
+static int sophgo_dump_setup(struct sophgo_dsi *dsi, struct platform_device *pdev)
+{
+	static const char *const names[] = {"sc_top", "disp", "dsi_mac"};
+	struct device *dev = &pdev->dev;
+	unsigned int phys[SOPHGO_DUMP_BLOCKS] = {0};
+	struct of_phandle_args clk = {0};
+	struct device_node *np;
+	struct resource res;
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		struct resource *r = platform_get_resource_byname(pdev, IORESOURCE_MEM, names[i]);
+
+		if (r && resource_size(r) >= SOPHGO_DUMP_PAGE) {
+			dsi->dump_sources.page[i] = dsi->regs[i];
+			phys[i] = r->start;
+		}
+	}
+	dsi->dump_sources.vip = dsi->vip.map;
+	np = of_parse_phandle(dev->of_node, "sophgo,vip-sys", 0);
+	if (np) {
+		if (!of_address_to_resource(np, 0, &res))
+			phys[SOPHGO_DUMP_VIP_SYS] = res.start;
+		of_node_put(np);
+	}
+	if (!of_parse_phandle_with_args(dev->of_node, "clocks", "#clock-cells", 0, &clk)) {
+		if (!of_address_to_resource(clk.np, 0, &res) && resource_size(&res) >= SOPHGO_DUMP_PAGE) {
+			void __iomem *page = of_iomap(clk.np, 0);
+
+			if (page && !devm_add_action_or_reset(dev, sophgo_dump_unmap, page)) {
+				dsi->dump_sources.page[SOPHGO_DUMP_CLK_CTRL] = page;
+				phys[SOPHGO_DUMP_CLK_CTRL] = res.start;
+			}
+		}
+		of_node_put(clk.np);
+	}
+	/* the D-PHY block is wired only under the pinstripe_dphy opt-in.
+	 * dsi->regs[SOPHGO_DPHY] is the driver's own window (0xcc, < a page, so it
+	 * is gated on the fenced span, not SOPHGO_DUMP_PAGE); the capture reads it
+	 * in-kernel while sophgo_link owns the clocks. Left NULL otherwise, so the
+	 * block stays valid=0 and no D-PHY access occurs.
+	 */
+	if (pinstripe_dphy) {
+		struct resource *r = platform_get_resource_byname(pdev, IORESOURCE_MEM, "dphy");
+
+		if (r && resource_size(r) >= SOPHGO_DUMP_FENCE_DPHY * 4) {
+			dsi->dump_sources.page[SOPHGO_DUMP_DPHY] = dsi->regs[SOPHGO_DPHY];
+			phys[SOPHGO_DUMP_DPHY] = r->start;
+		}
+	}
+	dsi->dump = kvzalloc(sizeof(*dsi->dump), GFP_KERNEL);
+	if (!dsi->dump)
+		return -ENOMEM;
+	ret = devm_add_action_or_reset(dev, sophgo_dump_free, dsi->dump);
+	if (ret)
+		return ret;
+	sophgo_dump_init(dsi->dump, phys);
+	dsi->dump_blob.data = dsi->dump;
+	dsi->dump_blob.size = sizeof(*dsi->dump);
+	dsi->debugfs = debugfs_create_dir("sophgo-dsi", NULL);
+	if (!IS_ERR(dsi->debugfs)) {
+		ret = devm_add_action_or_reset(dev, sophgo_debugfs_remove, dsi->debugfs);
+		if (ret)
+			return ret;
+		debugfs_create_blob("pinstripe-registers", 0400, dsi->debugfs, &dsi->dump_blob);
+	}
+	return 0;
+}
+
+static void sophgo_clk_put(void *data) { clk_put(data); }
+
+/* Resolve clk_bt_vip from the host's own clock provider by binding id. The
+ * paired DT lists nine host clocks and not this one; changing that list
+ * would change the DT/module contract, so look the gate up on the provider
+ * of the host's first clock (clock-controller@3002000, "sophgo,sg2000-clk")
+ * and verify the provider's name for that id before trusting it.
+ * dt-bindings/clock/sophgo,cv1800.h: CLK_BT_VIP 120 (clk-cv1800.c
+ * sg2000 hw table [CLK_BT_VIP] = clk_bt_vip). Devres puts it after the
+ * clocks-disable action registered later by sophgo_clocks_get().
+ */
+#define SOPHGO_CLK_BT_VIP 120
+static int sophgo_bt_clock_get(struct device *dev, struct clk **out)
+{
+	struct of_phandle_args args;
+	struct clk *clk;
+	int ret;
+
+	ret = of_parse_phandle_with_args(dev->of_node, "clocks", "#clock-cells", 0, &args);
+	if (ret)
+		return ret;
+	if (args.args_count != 1) {
+		of_node_put(args.np);
+		return -EINVAL;
+	}
+	args.args[0] = SOPHGO_CLK_BT_VIP;
+	clk = of_clk_get_from_provider(&args);
+	of_node_put(args.np);
+	if (IS_ERR(clk))
+		return PTR_ERR(clk);
+	if (!__clk_get_name(clk) || strcmp(__clk_get_name(clk), "clk_bt_vip")) {
+		clk_put(clk);
+		return -ENODEV;
+	}
+	ret = devm_add_action_or_reset(dev, sophgo_clk_put, clk);
+	if (ret)
+		return ret;
+	*out = clk;
+	return 0;
+}
+
+/* Called only from the clock-owned MAC start callback, before cleanup. */
+static void sophgo_mac_start_failure(struct sophgo_pipeline *p, unsigned int disp_cfg, int error) {
+	struct sophgo_dsi *dsi = container_of(p, struct sophgo_dsi, pipeline);
+
+	dev_err(
+	    dsi->host.dev,
+	    "MAC start error=%d MAC_EN initial=%#x final=%#x poll_us=%lld DISP_CFG=%#x TGEN=%u burst_max=%#x burst_hits=%u/%u\n",
+	    error, p->mac->start_initial, p->mac->start_final, (long long)p->mac->start_poll_us,
+	    disp_cfg, !!(disp_cfg & 0x80), p->mac->start_burst_max, p->mac->start_burst_hits,
+	    p->mac->start_burst_reads);
+}
