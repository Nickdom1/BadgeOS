+/* There is no safe forced reset or clock-off after an unacknowledged stop.
+ * Keep this callback and ALL host/consumer devres alive. Sleep without polling,
+ * panic or reboot; only the supervised physical recovery can release this
+ * terminal quarantine. Ordinary stop remains retryable before terminal remove.
+ */
+static void sophgo_terminal_quarantine(struct sophgo_dsi *dsi)
+{
+	DECLARE_COMPLETION_ONSTACK(physical_recovery);
+	dev_crit(dsi->host.dev, "pinstripe terminal containment: resources retained; physical recovery required\n");
+	for (;;)
+		wait_for_completion(&physical_recovery);
+}
+
+/* Defensive teardown also runs if DRM shutdown could not allocate a state.
+ * Caller has drained user operations. Never rely on a CRTC active flag to
+ * release partially acquired hardware. The bridge remains alive here.
+ */
+static void sophgo_pipeline_shutdown(struct sophgo_dsi *dsi)
+{
+	mutex_lock(&dsi->commit_lock);
+	drm_atomic_bridge_chain_disable(dsi->host_bridge, NULL);
+	drm_atomic_bridge_chain_post_disable(dsi->host_bridge, NULL);
+	if (sophgo_pipeline_owned(&dsi->pipeline)) {
+		dsi->terminal = true;
+		mutex_unlock(&dsi->commit_lock);
+		sophgo_terminal_quarantine(dsi);
+		return;
+	}
+	dsi->manual_request = false;
+	lt8912b_pipeline_bind(dsi->bridge, NULL);
+	if (dsi->pipeline.status.error)
+		dev_err(dsi->host.dev, "pipeline %s: %d\n", dsi->pipeline.status.stage,
+			dsi->pipeline.status.error);
+	mutex_unlock(&dsi->commit_lock);
+}
