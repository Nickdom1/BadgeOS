+# SPDX-License-Identifier: GPL-2.0-only
+config DRM_SOPHGO_DSI
+	tristate "Sophgo SG2000 display and DSI host"
+	depends on ARCH_SOPHGO
+	depends on DRM && OF && I2C && DRM_LONTIUM_LT8912B
+	select DRM_KMS_HELPER
+	select DRM_GEM_DMA_HELPER
+	select MFD_SYSCON
+	select DRM_MIPI_DSI
+	help
+	  Experimental display/DSI host with a manual 720p pinstripe path.
+	  General DRM active modesets and framebuffer scanout are unsupported.
