+static void sophgo_host_pre_enable(struct drm_bridge *bridge)
+{
+	struct sophgo_dsi *dsi = container_of(bridge, struct sophgo_host_bridge, bridge)->dsi;
+	struct sophgo_pipeline *p = &dsi->pipeline;
+	struct sophgo_kms *kms = dsi->drm->dev_private;
+	const struct drm_display_mode *m = dsi->manual_request ? &sophgo_golden_mode :
+		&kms->crtc.state->adjusted_mode;
+	struct mipi_dsi_device *dev = dsi->peripheral;
+	struct sophgo_mac_mode mode;
+	int ret;
+	if (!dev || (!dsi->pipeline_ready && !dsi->manual_request)) {
+		lt8912b_pipeline_error(&p->status, "activation hold", -EOPNOTSUPP);
+		return;
+	}
+	mode = (struct sophgo_mac_mode){m->clock,	m->hdisplay, m->hsync_start, m->hsync_end,
+					m->htotal,	m->vdisplay, m->vsync_start, m->vsync_end,
+					m->vtotal,	dev->lanes,  dev->format,    dev->channel,
+					dev->mode_flags};
+	ret = sophgo_pipeline_prepare(
+	    p, &mode, &dsi->lane_config,
+	    m->flags == (DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_PVSYNC) && m->vscan <= 1 ? 0x60 : 0,
+	    !dsi->manual_request && !!kms->crtc.state->event,
+	    !dsi->manual_request && !!kms->plane.state->fb,
+	    pattern_generator || dsi->manual_request, dsi->esc_parent,
+	    20000000, 900000000);
+	lt8912b_pipeline_error(&p->status, "host prepare", ret);
+}
