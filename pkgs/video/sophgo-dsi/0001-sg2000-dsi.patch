+static int sophgo_atomic_commit(struct drm_device *drm, struct drm_atomic_commit *state,
+				bool nonblock)
+{
+	struct sophgo_kms *kms = drm->dev_private;
+	int ret;
+
+	/* User commits are inside the fops SRCU section. File cleanup is
+	 * serialized by release_lock; shutdown owns host_lock/release_lock.
+	 * Do not reject unplug here: atomic_helper_shutdown commits AFTER
+	 * unplug has drained userspace. Late file cleanup sees dsi == NULL.
+	 */
+	if (!kms->dsi)
+		return -ENODEV;
+	/* No asynchronous bridge/host references may escape the operation. */
+	mutex_lock(&kms->dsi->commit_lock);
+	/* A generic inactive commit must not change or retry a manual request.
+	 * Unplug shutdown still reaches the defensive terminal containment path.
+	 */
+	if (kms->dsi->manual_request && !drm_dev_is_unplugged(drm)) {
+		mutex_unlock(&kms->dsi->commit_lock);
+		return -EBUSY;
+	}
+	ret = drm_atomic_helper_commit(drm, state, false);
+	if (sophgo_pipeline_complete(&kms->dsi->pipeline, kms->dsi->host_bridge))
+		dev_err(kms->dsi->host.dev, "pipeline %s: %d\n", kms->dsi->pipeline.status.stage,
+			kms->dsi->pipeline.status.error);
+	/* No events/scanout are accepted, so no vblank IRQ completion is owed.
+	 * Void enable failures are diagnostic only: active commits stay rejected
+	 * until a future activation design provides an honest userspace result.
+	 */
+	mutex_unlock(&kms->dsi->commit_lock);
+	return ret;
+}
