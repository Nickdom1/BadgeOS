+/* The connector belongs to the DRM device, never to I2C devres. There is
+ * no HPD worker/polling registration in this dormant host. All probe entry
+ * points (including sysfs fill_modes) are protected across bridge unbind.
+ */
+static enum drm_connector_status sophgo_connector_detect(struct drm_connector *connector,
+							 bool force)
+{
+	struct sophgo_kms *kms = container_of(connector, struct sophgo_kms, connector);
+	enum drm_connector_status status;
+	int idx;
+
+	if (!drm_dev_enter(connector->dev, &idx))
+		return connector_status_disconnected;
+	status = drm_bridge_detect(kms->dsi->bridge, connector);
+	drm_dev_exit(idx);
+	return status;
+}
+
+static int sophgo_connector_modes(struct drm_connector *connector)
+{
+	struct sophgo_kms *kms = container_of(connector, struct sophgo_kms, connector);
+	const struct drm_edid *edid;
+	int idx, count;
+
+	if (!drm_dev_enter(connector->dev, &idx))
+		return 0;
+	edid = drm_bridge_edid_read(kms->dsi->bridge, connector);
+	drm_edid_connector_update(connector, edid);
+	count = drm_edid_connector_add_modes(connector);
+	drm_edid_free(edid);
+	drm_dev_exit(idx);
+	return count;
+}
